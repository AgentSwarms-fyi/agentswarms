# Every secret the deployment needs, in one Secrets Manager secret, made inside
# AWS by a Lambda (deploy/aws/lambda/secrets-bootstrap): the JWT secret and the
# Supabase keys signed with it, the database roles' passwords, the app's own
# secrets. Terraform holds the secret's ARN and never a value, so its state is
# not a copy of them. A second apply adds what is missing and changes nothing
# that is there.
#
# Containers read single keys of the JSON (ECS: valueFrom "<arn>:jwt_secret::").

locals {
  tags = merge(var.tags, { "agentswarms:stack" = var.name })
  keys = [
    "jwt_secret", "anon_key", "service_role_key",
    "provider_creds_secret", "internal_run_secret", "notebook_runtime_secret",
    "docgen_token", "egress_pull_token", "spark_connect_token",
    "provenance_signing_secret", "metrics_token",
    "authenticator_password", "auth_admin_password", "storage_admin_password",
    "lakehouse_catalog_password", "admin_password",
  ]
}

resource "aws_secretsmanager_secret" "app" {
  name                    = "${var.name}/app"
  description             = "AgentSwarms ${var.name}: generated by the secrets-bootstrap Lambda; edit a key to rotate it, then redeploy"
  kms_key_id              = var.kms_key_arn
  recovery_window_in_days = var.recovery_window_days
  tags                    = local.tags
}

data "archive_file" "bootstrap" {
  type        = "zip"
  source_file = "${path.module}/../../../lambda/secrets-bootstrap/secrets_bootstrap.py"
  output_path = "${path.root}/.terraform/secrets-bootstrap.zip"
}

data "aws_iam_policy_document" "assume_lambda" {
  statement {
    actions = ["sts:AssumeRole"]
    principals {
      type        = "Service"
      identifiers = ["lambda.amazonaws.com"]
    }
  }
}

resource "aws_iam_role" "bootstrap" {
  name               = "${var.name}-secrets-bootstrap"
  assume_role_policy = data.aws_iam_policy_document.assume_lambda.json
  tags               = local.tags
}

data "aws_iam_policy_document" "bootstrap" {
  statement {
    sid       = "ThisSecretOnly"
    actions   = ["secretsmanager:GetSecretValue", "secretsmanager:PutSecretValue"]
    resources = [aws_secretsmanager_secret.app.arn]
  }
  statement {
    sid       = "ItsKey"
    actions   = ["kms:Decrypt", "kms:GenerateDataKey"]
    resources = [var.kms_key_arn]
  }
  statement {
    sid       = "OwnLogs"
    actions   = ["logs:CreateLogStream", "logs:PutLogEvents"]
    resources = ["${aws_cloudwatch_log_group.bootstrap.arn}:*"]
  }
}

resource "aws_iam_role_policy" "bootstrap" {
  name   = "secrets-bootstrap"
  role   = aws_iam_role.bootstrap.id
  policy = data.aws_iam_policy_document.bootstrap.json
}

resource "aws_cloudwatch_log_group" "bootstrap" {
  name              = "/aws/lambda/${var.name}-secrets-bootstrap"
  retention_in_days = 30
  tags              = local.tags
}

resource "aws_lambda_function" "bootstrap" {
  function_name    = "${var.name}-secrets-bootstrap"
  role             = aws_iam_role.bootstrap.arn
  runtime          = "python3.13"
  architectures    = ["arm64"]
  handler          = "secrets_bootstrap.handler"
  filename         = data.archive_file.bootstrap.output_path
  source_code_hash = data.archive_file.bootstrap.output_base64sha256
  timeout          = 30
  memory_size      = 128
  tags             = local.tags
  depends_on       = [aws_iam_role_policy.bootstrap, aws_cloudwatch_log_group.bootstrap]
}

# Runs on every apply where the secret or the code changed. It answers with
# the names it added, never values.
resource "aws_lambda_invocation" "bootstrap" {
  function_name = aws_lambda_function.bootstrap.function_name
  input         = jsonencode({ secret_id = aws_secretsmanager_secret.app.arn })
  triggers = {
    code = data.archive_file.bootstrap.output_base64sha256
  }
}
