#!/bin/bash
# AgentSwarms on one VM of an Auto Scaling group (deploy/aws/terraform/vm),
# rendered by Terraform. Runs at first boot: Docker, the deployment's secrets
# from Secrets Manager, then every container, each restarted by Docker if it
# dies. User code does not run here: sandboxes are Fargate tasks.
#
# Two Docker networks:
#   agentswarms  the app and Supabase's services; reaches the internet and the
#                instance's role (the app signs S3 and ECS calls with it)
#   untrusted    docgen and js-sandbox, which handle input users wrote:
#                internal, so no route out at all, and no instance metadata
set -euo pipefail
exec > >(tee -a /var/log/agentswarms-boot.log) 2>&1

REGION="${region}"
SECRET_ID="${secret_arn}"
RELEASE="${release}"
REG="${source_registry}"

dnf install -y docker jq
systemctl enable --now docker

SECRET="$(aws secretsmanager get-secret-value --region "$REGION" --secret-id "$SECRET_ID" --query SecretString --output text)"
s() { jq -r --arg k "$1" '.[$k] // empty' <<<"$SECRET"; }

install -d -m 0700 /etc/agentswarms
umask 077

cat >/etc/agentswarms/auth.env <<EOF
GOTRUE_API_HOST=0.0.0.0
GOTRUE_API_PORT=9999
API_EXTERNAL_URL=${public_url}/auth/v1
GOTRUE_DB_DRIVER=postgres
GOTRUE_DB_DATABASE_URL=postgres://supabase_auth_admin@${db_host}:5432/postgres?sslmode=require
PGPASSWORD=$(s auth_admin_password)
GOTRUE_SITE_URL=${public_url}
GOTRUE_URI_ALLOW_LIST=${public_url}/**
GOTRUE_JWT_SECRET=$(s jwt_secret)
GOTRUE_JWT_AUD=authenticated
GOTRUE_JWT_DEFAULT_GROUP_NAME=authenticated
GOTRUE_JWT_ADMIN_ROLES=service_role
GOTRUE_JWT_EXP=3600
GOTRUE_EXTERNAL_EMAIL_ENABLED=true
GOTRUE_MAILER_AUTOCONFIRM=${mailer_autoconfirm}
${gotrue_smtp}
EOF

cat >/etc/agentswarms/rest.env <<EOF
PGRST_DB_URI=postgres://authenticator@${db_host}:5432/postgres?sslmode=require
PGPASSWORD=$(s authenticator_password)
PGRST_DB_SCHEMAS=public,storage
PGRST_DB_ANON_ROLE=anon
PGRST_SERVER_PORT=3000
PGRST_JWT_SECRET=$(s jwt_secret)
EOF

cat >/etc/agentswarms/storage.env <<EOF
POSTGREST_URL=http://rest:3000
DATABASE_URL=postgres://supabase_storage_admin@${db_host}:5432/postgres?sslmode=require
PGPASSWORD=$(s storage_admin_password)
STORAGE_BACKEND=s3
GLOBAL_S3_BUCKET=${storage_bucket}
REGION=$REGION
TENANT_ID=stub
FILE_SIZE_LIMIT=52428800
SERVER_PORT=5000
ANON_KEY=$(s anon_key)
SERVICE_KEY=$(s service_role_key)
AUTH_JWT_SECRET=$(s jwt_secret)
EOF

cat >/etc/agentswarms/app.env <<EOF
${app_env}
SUPABASE_PUBLISHABLE_KEY=$(s anon_key)
PUBLIC_SUPABASE_PUBLISHABLE_KEY=$(s anon_key)
SUPABASE_SERVICE_ROLE_KEY=$(s service_role_key)
PROVIDER_CREDS_SECRET=$(s provider_creds_secret)
INTERNAL_RUN_SECRET=$(s internal_run_secret)
NOTEBOOK_RUNTIME_SECRET=$(s notebook_runtime_secret)
NOTEBOOK_EGRESS_PULL_TOKEN=$(s egress_pull_token)
DOCGEN_TOKEN=$(s docgen_token)
PROVENANCE_SIGNING_SECRET=$(s provenance_signing_secret)
METRICS_TOKEN=$(s metrics_token)
LAKEHOUSE_CATALOG_PASSWORD=$(s lakehouse_catalog_password)
EOF

cat >/etc/agentswarms/gateway.env <<EOF
PORT=8090
SUPABASE_URL=${public_url}
SUPABASE_SERVICE_ROLE_KEY=$(s service_role_key)
NOTEBOOK_RUNTIME_SECRET=$(s notebook_runtime_secret)
HTTP_KEEPALIVE_TIMEOUT_MS=125000
EOF

cat >/etc/agentswarms/docgen.env <<EOF
DOCGEN_TOKEN=$(s docgen_token)
EOF

cat >/etc/agentswarms/js-sandbox.env <<EOF
PORT=8091
INTERNAL_RUN_SECRET=$(s internal_run_secret)
EOF

cat >/etc/agentswarms/gateway.conf <<'EOF'
${gateway_conf}
EOF
umask 022

docker network create agentswarms >/dev/null 2>&1 || true
docker network create --internal untrusted >/dev/null 2>&1 || true

run() { # name, then docker run arguments
  local name=$1; shift
  docker rm -f "$name" >/dev/null 2>&1 || true
  docker run -d --name "$name" --restart unless-stopped \
    --log-driver awslogs --log-opt awslogs-region="$REGION" \
    --log-opt awslogs-group="${log_group}" --log-opt awslogs-stream="$(hostname)/$name" \
    "$@"
}

run auth --network agentswarms --env-file /etc/agentswarms/auth.env ${gotrue_image}
run rest --network agentswarms --env-file /etc/agentswarms/rest.env ${postgrest_image}
run storage --network agentswarms --env-file /etc/agentswarms/storage.env ${storage_image}
run supabase-gateway --network agentswarms -p 8000:8000 \
  -v /etc/agentswarms/gateway.conf:/etc/nginx/conf.d/default.conf:ro ${nginx_image}
run docgen --network untrusted --env-file /etc/agentswarms/docgen.env "$REG/docgen:$RELEASE"
run js-sandbox --network untrusted --env-file /etc/agentswarms/js-sandbox.env "$REG/js-sandbox:$RELEASE"
run notebook-gateway --network agentswarms -p 8090:8090 --env-file /etc/agentswarms/gateway.env \
  --read-only "$REG/notebook-gateway:$RELEASE"
run app --network agentswarms -p 8080:8080 --env-file /etc/agentswarms/app.env \
  --stop-timeout 60 "$REG/agentswarms:$RELEASE"
# The app reaches docgen and js-sandbox on their internal network too.
docker network connect untrusted app

echo "agentswarms $RELEASE started"
