# =============================================================================
#  AgentSwarms configuration
# =============================================================================
#  Three tiers, in order:
#
#    1. REQUIRED     — the app will not run correctly without these.
#    2. RECOMMENDED  — it runs, but a core capability is missing or degraded.
#    3. OPTIONAL     — everything else. Sensible defaults; skip the lot.
#
#  Only section 1 is needed for a first run. Full walkthrough: docs/INSTALL.md
#  Every row/timeout/concurrency cap and what it bounds: docs/SCALE_AND_LIMITS.md
# =============================================================================
#
# Every service ships with every install — there are no compose profiles — and
# the values below already point at them (qdrant, valkey, lakehouse-catalog,
# minio, spark-connect). Replace any of them with a managed equivalent; leave
# them as they are for the bundled ones.
# `scripts/setup.sh --dev` rewrites them to 127.0.0.1 for an app run on the host.


# =============================================================================
#  1. REQUIRED
# =============================================================================

# ── Supabase: your database, auth and file storage ───────────────────────────
# Supabase Cloud: Project → Settings → API.
# Self-hosted Supabase (full data residency / air-gap): see
# docs/DEPLOYMENT.md § "Self-hosted Supabase".
#
# NOTE: the Supabase *Project ID* is deliberately NOT here. Nothing at runtime
# reads it — the CLI takes it as a flag: `supabase link --project-ref <id>`.
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# The same URL and PUBLISHABLE key again, VITE_-prefixed. Vite only inlines
# vars starting with VITE_ into the browser bundle, and the two halves of the
# app (server routes/functions vs. the React client) each need their own copy.
#
# NEVER put the service-role key behind a VITE_ prefix — that ships a
# database-bypassing secret to every visitor's browser.
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# One image, any environment: every browser setting (VITE_*) also has a
# PUBLIC_ name that the server reads when it STARTS and hands to the page, so
# changing it takes a restart, not a rebuild. Per setting, PUBLIC_ wins, then
# VITE_ in the server's environment, then VITE_ baked in at build (only
# `npm run build` on the host bakes any: the Docker image is built with none,
# R469). Leave the PUBLIC_ names empty and nothing changes: Compose hands this
# file to the running server. A value that fails its check is ignored, with a
# warning naming it; a service-role or sb_secret_ key is always refused, and
# the build stops if VITE_SUPABASE_PUBLISHABLE_KEY is one.
# Details: docs/DEPLOYMENT.md § "Browser settings at runtime".
PUBLIC_SUPABASE_URL=""
PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# ── Which release ────────────────────────────────────────────────────────────
# Empty: Compose builds every image from this checkout (`docker compose up -d
# --build`). A version (1.7.0): Compose runs that release's published, signed
# images instead; `docker compose pull && docker compose up -d --no-build`.
# To go back, set the previous version and run the same two commands. Never
# pass --build with a version set: it would build this checkout under the
# release's name. docs/DEPLOYMENT.md, "Upgrades".
AGENTSWARMS_VERSION=""
# Where those images come from; your mirror's path for an air-gapped install.
AGENTSWARMS_REGISTRY=""                 # default ghcr.io/agentswarms-fyi

# Supabase Realtime: live updates for the approvals inbox. Hosted and
# self-hosted Supabase run it; leave this empty. On a plain PostgreSQL such as
# Amazon RDS it cannot run (it needs a true superuser), so set "off" there and
# the inbox checks every 15 seconds instead. With it on, the inbox also falls
# back to checking when its connection fails.
VITE_SUPABASE_REALTIME=""   # on
PUBLIC_SUPABASE_REALTIME="" # the same, read at runtime (wins when set)

# ── Operator account ─────────────────────────────────────────────────────────
# The email allowed into the instance admin dashboard. BOTH must be set and
# they must MATCH — the server enforces access, the client decides what to
# render. Use the address you will sign up with.
ADMIN_EMAIL=""
VITE_ADMIN_EMAIL=""
PUBLIC_ADMIN_EMAIL=""      # runtime alternative to VITE_ADMIN_EMAIL (wins when set)

# ── Encryption key for stored credentials ────────────────────────────────────
# Encrypts every credential at rest: LLM provider and gateway keys, n8n tokens,
# MCP bearer tokens, warehouse connections, Secrets Manager, Data Catalog
# bucket keys. Generate once:
#
#   openssl rand -hex 32
#
# Required before anyone connects a provider or a warehouse. Rotating it does
# not re-encrypt anything — saved credentials become unreadable and must be
# re-entered. Back it up separately from your database: a database backup
# without this key cannot restore credentials.
PROVIDER_CREDS_SECRET=""

# Previous credential keys, comma-separated, accepted for DECRYPTION only.
# Set this while rotating: move the outgoing secret here, put the new one in
# PROVIDER_CREDS_SECRET, restart, then run Admin -> IAM -> Settings ->
# "Re-encrypt to current key". Remove this once nothing is left on the old key.
# See SECURITY.md#rotating-the-credential-key.
PROVIDER_CREDS_SECRET_OLD=""

# External key provider (envelope encryption). Leave KMS_PROVIDER unset (env)
# and credentials are encrypted under PROVIDER_CREDS_SECRET as above. With
# "vault", a random data key is wrapped by a Vault Transit key that never
# leaves Vault, unwrapped once per process start; the app holds a permission
# to decrypt, not the key. Set the VAULT_* lines, restart, create the data key
# on Admin -> IAM -> Settings -> Credential encryption key, THEN set the
# provider to "vault" and restart; the existing re-encrypt sweep moves the
# rows. A process that cannot unwrap the data key refuses to start.
# "aws" is the same with an AWS KMS key; the app signs as its own role (IRSA,
# ECS task role, EKS Pod Identity, instance profile) or the AWS_* keys.
# "azure" is the same with an Azure Key Vault or Managed HSM key; the app
# signs in as its own managed or workload identity, or the AZURE_* variables.
# "gcp" is the same with a Cloud KMS key; the app signs in as its service
# account on the metadata server, or through GOOGLE_APPLICATION_CREDENTIALS.
# "oci" is the same with an OCI Vault key; the app signs as its instance or
# resource principal, or with an API key from an OCI config file.
KMS_PROVIDER=""                         # env (default) | vault | aws | azure | gcp | oci
KMS_KEY_REF=""                          # vault: transit/keys/<name>; aws: arn:aws:kms:<region>:<account>:key/<id>; azure: https://<vault>.vault.azure.net/keys/<name>; gcp: projects/<p>/locations/<l>/keyRings/<r>/cryptoKeys/<k>; oci: ocid1.key.oc1.<region>.<vault>.<id>
VAULT_ADDR=""                           # e.g. https://vault.internal:8200
VAULT_TOKEN=""                          # or VAULT_TOKEN_FILE (a mounted secret), or VAULT_K8S_ROLE
VAULT_TOKEN_FILE=""
VAULT_K8S_ROLE=""                       # Kubernetes auth: the Vault role bound to this pod's service account
VAULT_K8S_MOUNT=""                      # kubernetes — the auth method's mount path
VAULT_K8S_JWT_FILE=""                   # the service-account token sent to Vault; default /var/run/secrets/kubernetes.io/serviceaccount/token
VAULT_NAMESPACE=""                      # Vault Enterprise namespaces only
# AWS KMS (KMS_KEY_REF above). The identity: nothing to set under a role;
# outside AWS, AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY. The full list,
# and the key policy to give the role, in docs/KEY_MANAGEMENT.md#aws-kms.
AWS_REGION=""                           # only when KMS_KEY_REF is an alias or key id, not an ARN
AWS_USE_FIPS_ENDPOINT=""                # true: kms-fips.<region>.amazonaws.com
AWS_ENDPOINT_URL_KMS=""                 # a KMS VPC endpoint's DNS name, or an emulator
# The AWS CLI's name for the region, read only when AWS_REGION is empty: for
# a KMS key named by alias or key id, for the ECS sandbox backend, and for
# the lakehouse's own AWS credential chain (after LAKEHOUSE_S3_REGION, then
# us-east-1). No default for KMS and ECS: without a region they fail with an
# error that names AWS_REGION.
# AWS_DEFAULT_REGION=
# One endpoint for every AWS API the app calls: KMS, STS (web identity
# sign-in), and the ECS sandbox backend's ECS and CloudWatch Logs calls. A
# service's own variable wins: AWS_ENDPOINT_URL_KMS, AWS_ENDPOINT_URL_STS,
# AWS_ENDPOINT_URL_ECS, AWS_ENDPOINT_URL_LOGS. Meant for an emulator that
# answers every service on one address; a VPC endpoint serves one service,
# so use the per-service names for those. An origin only (scheme, host,
# port): KMS refuses a path. Unset, each service's regional AWS endpoint.
# AWS_ENDPOINT_URL=
KMS_REQUIRE_PRIVATE=""                  # true: refuse a KMS / STS / Key Vault / Cloud KMS / OCI Vault call that would go to a public address
# Azure Key Vault (KMS_KEY_REF above). The identity: nothing to set under a
# system-assigned managed identity; AZURE_CLIENT_ID alone picks a
# user-assigned one; AKS workload identity sets its own variables. Outside
# Azure, a service principal: AZURE_TENANT_ID + AZURE_CLIENT_ID, and
# AZURE_CLIENT_CERTIFICATE_PATH (a PEM with the key and the certificate) or
# AZURE_CLIENT_SECRET. AZURE_AUTHORITY_HOST for a sovereign cloud. The full
# list, and the role to grant, in docs/KEY_MANAGEMENT.md#azure-key-vault.
# Google Cloud KMS (KMS_KEY_REF above). The identity: nothing to set on
# Compute Engine, GKE with workload identity or Cloud Run (the metadata
# server; GCE_METADATA_HOST moves it). Elsewhere GOOGLE_APPLICATION_CREDENTIALS,
# a workload identity federation (external_account) file, or a service
# account key. The full list, and the role to grant, in
# docs/KEY_MANAGEMENT.md#google-cloud-kms.
GCP_KMS_ENDPOINT=""                     # a regional, Private Service Connect (cloudkms-<ep>.p.googleapis.com) or emulator endpoint
# OCI Vault (KMS_KEY_REF above, the key's OCID). The identity: nothing to set
# on an instance in a dynamic group (the instance principal;
# OCI_METADATA_BASE_URL and OCI_FEDERATION_ENDPOINT move its two calls); where
# OCI provides a resource principal, OCI_RESOURCE_PRINCIPAL_VERSION (2.2) and
# its token and key; elsewhere OCI_CONFIG_FILE, the file `oci setup config`
# writes (OCI_CONFIG_PROFILE, default DEFAULT). OCI_AUTH names one of
# api_key, instance_principal, resource_principal. The full list, and the
# policy to write, in docs/KEY_MANAGEMENT.md#oci-vault.
OCI_KMS_CRYPTO_ENDPOINT=""              # the vault's Cryptographic Endpoint: https://<vault>-crypto.kms.<region>.oraclecloud.com
OCI_KMS_MANAGEMENT_ENDPOINT=""          # only for the key's details on the card; taken from the crypto endpoint when it is Oracle's name
# Every user's credentials are under their own key, and a customer key (Admin →
# IAM → Settings → Customer keys) can wrap its members' keys. How long a process
# keeps one unwrapped: an erased, destroyed or revoked key stops working within
# this long everywhere. 0 keeps none (every read of a customer member's value
# calls their KMS).
DATA_KEY_CACHE_SECONDS=""               # default 300
# The documents chat generates and the copies of uploaded datasets are stored
# encrypted under their owner's user key (docs/KEY_MANAGEMENT.md, Stored
# files). The largest document the app keeps, and how many files stored before
# that one hourly pass encrypts (the card's Encrypt stored files has no limit).
CHAT_DOC_MAX_BYTES=""                   # default 52428800 (50 MB)
STORED_FILES_PER_PASS=""                # default 25
# What agents remember about each user (long-term memory, conversation
# summaries, scratchpads) is encrypted the same way since R445: how many values
# kept before that one hourly pass encrypts (the button has no limit).
MEMORY_SEAL_PER_PASS=""                 # default 1000
# Agent Chat history (every message and conversation title) is encrypted the
# same way since R446: how many values kept before that one hourly pass
# encrypts (the button has no limit).
CHAT_SEAL_PER_PASS=""                   # default 2000
# Model call traces (prompts, requests, replies, tool calls) are encrypted the
# same way since R448, and swarm run traces since R449: how many kept before
# that one hourly pass encrypts, of each (the button has no limit).
TRACE_SEAL_PER_PASS=""                  # default 2000
# Approval requests and notifications are encrypted the same way since R450: how
# many values kept before that one hourly pass encrypts (the button has no limit).
INBOX_SEAL_PER_PASS=""                  # default 2000


# =============================================================================
#  2. RECOMMENDED
# =============================================================================

# ── Default LLM provider (OpenRouter) ────────────────────────────────────────
# Without it the app still runs, but every user must connect their own provider
# key under /integrations before any agent, swarm or notebook can call a model.
# When set it is the app-wide zero-config default; a user's own saved key always
# takes precedence. No per-user caps are applied — you own the key and the bill.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=""
# The default model is NOT set here: a superadmin sets it under Admin ->
# Developer runtime -> AI services -> Default model, and everything without a
# model of its own (or whose own can't run for the person) uses it.
# OPENROUTER_DEFAULT_MODEL is no longer read.
# Override if you route OpenRouter through a proxy/gateway.
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# ── Knowledge Base embeddings ────────────────────────────────────────────────
# There is no embeddings key here on purpose. Vector search (RAG) runs on
# whichever model provider is connected under /integrations, and OPENROUTER_API_KEY
# above covers it with no per-user setup -- OpenRouter does serve /embeddings
# (an earlier version of this file claimed otherwise, which is what made an
# OpenAI account look mandatory). Connect nothing and documents still work, via
# keyword search.
#
# What one answer reads from a knowledge base (docs/KNOWLEDGE_BASES.md → What
# the model reads). Each cited document carries its best few chunks in reading
# order; the turn is capped as a whole. Raise the budget for a large-window
# model and questions that span documents; lower it for a small model.
# KB_CHUNKS_PER_DOCUMENT=3
# KB_CITATION_CHARS_PER_CHUNK=1600
# KB_GROUNDING_MAX_CHARS=12000
#
# Below this best cosine similarity, with no keyword hit, a turn is not
# grounded at all (the model is told the search found nothing) — so "what is
# the weather" stops carrying five documents it must ignore. Measured with
# text-embedding-3-small: document questions 0.38–0.75, off-topic 0.10–0.32.
# Other embedding models score differently; 0 disables the floor.
# KB_MIN_SIMILARITY=0.3
#
# A sync claims its source; a second press of Sync now, or a scheduled pass,
# is told one is already running (R313). A sync that died leaves its claim,
# which another may take once the source has not changed for this long.
# KB_SYNC_LEASE_MINUTES=60
#
# A catalog crawl claims its source the same way (R315): a second Crawl now,
# or a scheduled pass, is told one is running, and a crawl that died leaves a
# claim another may take once the source has not changed for this long.
# CATALOG_CRAWL_LEASE_MINUTES=60
# Objects one bucket crawl lists. A listing that stops here removes nothing,
# and says so; narrow the source with a prefix before raising this.
# CATALOG_MAX_OBJECTS=50000

# ── Where knowledge-base vectors are searched ────────────────────────────────
# Without VECTOR_STORE: pgvector, in the Supabase Postgres you already run.
# Nothing extra to back up, and the permission check is the row-level security
# already protecting the chunks. VECTOR_STORE="pgvector" keeps it that way, and
# the installers leave a value you set alone.
#
# Qdrant ships with every install and is the default here. The reason is
# CAPACITY, not availability: an HNSW index wants RAM, and by default it wants
# it from the same instance serving traces, audit, BI and every OLTP query.
# Qdrant is a place to put the index that scales on its own. It does NOT make
# retrieval survive a Postgres outage -- every hit is hydrated from kb_chunks --
# but it does mean losing the INDEX costs only speed: every vector is also a
# column on its chunk row, and retrieval searches that copy while Qdrant is
# down. Qdrant holds VECTORS AND TWO IDS; the chunk text, the documents and the
# permissions stay in Postgres, and the app fills the index from them by itself
# (a new or lost volume, or an install just switched to it), searching Postgres
# for a collection until the index has all of it (R417).
#
# ONE QDRANT NODE IS NOT HIGH AVAILABILITY. For that, run a Qdrant cluster and
# set QDRANT_REPLICATION to at least 2; the admin page reports the replication
# the collection actually has, not the one you asked for.
#
# THIS IS A DEFAULT, NOT A DECISION FOR THE WHOLE DEPLOYMENT. Each knowledge
# base can pick its own index in RAG Settings -> Retrieval -> Vector index, and
# only the ones that picked nothing follow the value below. Changing a
# collection's index moves the vectors it already has; nothing is re-embedded.
#
VECTOR_STORE="qdrant"
QDRANT_URL="http://qdrant:6333"
# QDRANT_API_KEY=
# QDRANT_COLLECTION=agentswarms_kb_chunks
# QDRANT_REPLICATION=1
# QDRANT_SHARDS=1
# How long retrieval trusts a collection's last count of the index (seconds;
# 0 trusts the index without counting), and how often the scheduler checks
# every collection on it (minutes; 0 turns the sweep off).
# VECTOR_INDEX_CHECK_SECONDS=300
# VECTOR_INDEX_SYNC_MINUTES=10
#
# The bundled Qdrant takes an API key. The installers generate one and set
# BOTH of these to it: the first is what the bundled server demands, the second
# is what the app sends. Two settings because most deployments point at a
# Qdrant this project did not start. Without a key, anything on the compose
# network reads every knowledge base's vectors, spark-connect included, where
# Spark pipelines' Python UDFs run (VA-41). Leave both unset rather than empty:
# Qdrant reads an EMPTY key as "auth is on, and the key is empty", and then
# rejects every request.
#
#   QDRANT__SERVICE__API_KEY=some-long-random-string
#   QDRANT_API_KEY=some-long-random-string

# ── Online feature store ─────────────────────────────────────────────────────
# Where a feature view's latest row per key is SERVED from. Unset means every
# lookup reads the lakehouse, which is what happened before this existed:
# correct, and measured at ~130 ms at best against ~2 ms here, because the
# access check ahead of a governed statement is a round trip to Postgres.
#
# Nothing in the store is a source of truth. A miss, a stale entry, a server
# that does not answer -- every one of them falls back to the lakehouse and
# answers correctly. Losing this service costs latency and nothing else.
#
# Compose starts a single valkey. Valkey rather than Redis because Redis moved
# to RSALv2/SSPL; the protocol is the same, so FEATURE_STORE_URL can point at
# either, or at a managed one (put its password in the URL:
# redis://:PASSWORD@host:6379). rediss:// is TLS, for a store with in-transit
# encryption (ElastiCache among them): the certificate is always verified, and
# a private CA goes in NODE_EXTRA_CA_CERTS.
#
# VALKEY_PASSWORD: the bundled valkey requires it and the app sends it. The
# installers generate it. Empty means no password, which leaves every user's
# online features open to anything on the compose network (VA-41).
#
FEATURE_STORE_URL="redis://valkey:6379"
VALKEY_PASSWORD=""
# FEATURE_STORE_STALE_MINUTES=60       # per-view setting overrides this
# FEATURE_STORE_MAX_KEYS=500000        # keys one refresh will write
# FEATURE_STORE_MAXMEMORY=256mb        # what the bundled server is given

# ── Public URL ───────────────────────────────────────────────────────────────
# Used in outbound email links and as the default origin for scheduled work.
# Change it to your real https:// origin in production, or emailed links point
# at localhost.
SITE_URL="http://localhost:8080"


# =============================================================================
#  3. OPTIONAL
# =============================================================================

# ── Agent web tools (search + browse) ────────────────────────────────────────
# Powers web_search + web_browse workspace-wide. Get a key at
# https://firecrawl.dev
#   • WITHOUT a key, web_search still runs but falls back to DuckDuckGo's free
#     Instant Answer API — entity summaries only, so results are thin/empty for
#     ordinary queries.
#   • WITHOUT a key, web_browse still works via the built-in fetcher: it strips
#     page chrome and converts to markdown, but does NOT run JavaScript, so a
#     client-rendered app returns an empty shell — reported as thin rather than
#     passed off as content. A key adds JavaScript rendering. The same applies
#     to adding a URL as a knowledge-base source.
# You do NOT have to set this here — two UI alternatives exist:
#   • Connect Firecrawl on the Integrations page (encrypted, no restart).
#   • Give one agent its own key in the agent editor's web tools
#     (Brave / SerpAPI / Tavily for search; ScrapingBee or custom Firecrawl).
# Resolution order: per-agent key → this var → the Integrations connector.
FIRECRAWL_API_KEY=""

# ── Web analytics for YOUR deployment (both default to off) ──────────────────
# When set, public pages show a consent banner and load Google Analytics / Tag
# Manager with YOUR ids after the visitor accepts. Left unset, no banner is
# shown and no analytics request is ever made — which is what the "no
# telemetry" statement on /architecture and /security describes.
VITE_GA_ID=""
VITE_GTM_ID=""
# The same, read at runtime (win when set). Letters, digits and dashes only.
PUBLIC_GA_ID=""
PUBLIC_GTM_ID=""

# ── JS sandbox for headless custom code ──────────────────────────────────────
# Function nodes and custom components run user-authored JavaScript. On the
# canvas that runs in the browser; for DEPLOYED (API-key) and SCHEDULED runs it
# runs in a separate hardened container so it never shares a process with your
# service-role key.
#
#   docker compose --profile sandbox up -d --build
#
# Inside Compose the app already defaults to http://js-sandbox:8091, so leave
# this empty. Set it only when the app runs on the HOST (npm run dev), where the
# service is published on loopback:
#   JS_SANDBOX_URL="http://127.0.0.1:8091"
#
# Unset = custom code stays canvas-only, and deployed runs say so rather than
# failing mysteriously. Details: docs/DEPLOYMENT.md § "JS sandbox".
JS_SANDBOX_URL=""
# Ceilings enforced BY the sandbox (a caller cannot raise them).
JS_SANDBOX_MAX_TIMEOUT_MS="5000"
JS_SANDBOX_MAX_CONCURRENT="4"
JS_SANDBOX_MEM_MB="128"
# Largest /run request the sandbox accepts (code + context), in bytes.
JS_SANDBOX_MAX_BODY_BYTES="1000000"

# ── BI widget snapshot size ──────────────────────────────────────────────────
# Rows kept in a BI widget's cached snapshot (default 500, ceiling 100000).
# The snapshot is what shared links, public embeds and offline views render,
# and it lives inside the dashboard row — so raising it trades storage and
# dashboard load time for how much raw data a browser-side sum can see. An
# aggregated widget (agg_pushdown) needs far less than 500; a widget summing
# RAW rows is capped here and reports `truncated` when it hits it.
# PUBLIC_BI_SNAPSHOT_ROWS_CAP is read when the app starts (change it, restart);
# VITE_BI_SNAPSHOT_ROWS_CAP is baked in at BUILD time (change it, rebuild). The
# PUBLIC_ one wins when set; the browser and the scheduled refresh read the
# same value either way. Details: docs/SCALE_AND_LIMITS.md
VITE_BI_SNAPSHOT_ROWS_CAP=""
PUBLIC_BI_SNAPSHOT_ROWS_CAP=""

# ── Outbound email (all optional) ────────────────────────────────────────────
# Transactional emails (welcome, budget alerts, certificates) are best-effort:
# with none of these set, sends are skipped and logged — the app works fine.
# Auth emails (confirmation, password reset) are sent by Supabase itself and
# are configured in your Supabase dashboard, not here.
#
# NO ACCOUNT IS REQUIRED for either option. SMTP is built in, so any relay you
# already have works with no third party involved. Pick whichever you have.
#
# Option A — any SMTP server. Set these four and you are done: a corporate
# relay, SES, a provider's free tier, or a machine you run. Port 587 with
# STARTTLS is the usual choice; 465 turns on implicit TLS automatically.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
#
# Option B — Resend (https://resend.com; a hosted HTTP API, for deployments
# with no relay to point at). Takes precedence when both are set.
# The key alone is NOT enough: add your domain in Resend, publish the SPF/DKIM
# DNS records it gives you, verify it, then set EMAIL_FROM to an address on that
# domain. Until a domain is verified Resend sends only from onboarding@resend.dev
# and delivers only to the account owner's own address — fine for a smoke test,
# useless for real users. See docs/INSTALL.md.
RESEND_API_KEY=""
# From address for all outbound mail: 'AgentSwarms <noreply@your-domain.com>'.
# MUST be on a domain verified with your provider. Left empty it falls back to
# noreply@example.com, which Resend rejects — every app email then fails while
# the app looks healthy. Check the email_send_log table if mail stops arriving.
EMAIL_FROM=""
# (SITE_URL is declared once, in section 2 — email links use it too.)

# ── Internal self-calls (deployed swarms, scheduled runs, workflows) ─────────
# Headless swarm runs (deployed, scheduled, and a workflow's Swarm step)
# execute their LLM nodes by calling this app's OWN /api/chat over HTTP,
# authenticated with an internal shared secret.
#
# The origin for those self-calls is resolved ONLY from configuration —
# PUBLIC_APP_URL, then SITE_URL, then http://127.0.0.1 on PORT, the port
# `node server.mjs` listens on (default 8080; see HOST and PORT below). It is
# never taken from the incoming request's Host header, which a caller controls
# and which would otherwise leak the secret below to an attacker's server.
#
# Leave PUBLIC_APP_URL empty for normal single-container/VM deploys (the
# loopback fallback works). Set it when the app can't reach itself on localhost
# from inside its own container (e.g. some PaaS / split ingress setups).
PUBLIC_APP_URL=""

# Shared secret for those internal self-calls and the JS sandbox. RECOMMENDED:
# any long random string (scripts/setup.sh generates one). If unset, the app and
# the sandbox both DERIVE a secret from the service-role key (an HMAC; R463), so
# it still works with no setting and the key itself never goes into a request
# header. A secret of its own lets you rotate it without rotating the key.
INTERNAL_RUN_SECRET=""

# ── Deployed-swarm limits (POST /api/swarm/run) ──────────────────────────────
# A swarm run can make many model calls and hold a worker for minutes, so each
# API key is bounded. Counters are per app instance: behind a load balancer with
# N instances the effective ceiling is N x these values (enforce a hard global
# limit at your ingress/CDN if you need one).
#
# Requests per minute per API key (default 30).
SWARM_RUN_RATE_LIMIT_PER_MIN=""
# Simultaneous in-flight runs per API key (default 5).
SWARM_RUN_MAX_CONCURRENT=""
# Whole-run wall-clock budget in ms, shared by nested Execute-Swarm nodes
# (default 600000 = 10 minutes). Raise it for long foreach/loop swarms.
SWARM_RUN_TIMEOUT_MS=""
# How often a run the server executes checks whether it was cancelled from
# Recent runs, in ms (default 2000). A cancelled run stops before its next
# node and aborts the model call in flight (R309).
SWARM_CANCEL_POLL_MS=""

# ── Outbound fetch safety (HTTP nodes, web_browse, provider tests, MCP) ───────
# Everything that fetches a URL chosen by a user or the MODEL from inside your
# network goes through one guard: swarm HTTP nodes, the web_browse tool, the
# "Test connection" button on the Integrations page (Ollama / vLLM / n8n and any
# custom base_url), the n8n webhook, and MCP server probe/tool calls.
#
# Cloud instance metadata and link-local addresses (169.254.169.254 and the rest
# of 169.254.0.0/16, IPv6 link-local) are ALWAYS refused — they can hand out the
# host's IAM credentials and nothing legitimately fetches them. Ordinary private
# networks (localhost, RFC1918, in-cluster) are ALLOWED BY DEFAULT, because
# self-hosted model servers, MCP servers and n8n live there. Every redirect hop
# is re-validated so a public URL can't 302 into a blocked range.
#
# Set BLOCK_PRIVATE_NETWORK_FETCH=true to ALSO refuse ordinary private/internal
# targets — recommended for untrusted multi-tenant installs or public embeds,
# where web_browse is model-driven and could be steered at your internal network.
# (metadata stays blocked either way.)
BLOCK_PRIVATE_NETWORK_FETCH=""
# Legacy: forces the permissive behaviour even if BLOCK_… is set. You normally
# don't need this now that private networks are allowed by default.
ALLOW_PRIVATE_NETWORK_FETCH=""
# Signs the post-turn webhook an agent sends to its n8n workflow, which
# carries the prompt and the reply. When set, each delivery carries
# X-AgentSwarms-Timestamp (milliseconds since the epoch) and
# X-AgentSwarms-Signature: v1=<hex HMAC-SHA256 of "<timestamp>.<raw body>">,
# so the receiver can check where it came from and reject replays. Unset, the
# webhooks go unsigned. Any long random string (`openssl rand -hex 32`); give
# the receiver the same value.
# WEBHOOK_SIGNING_SECRET=

# ── HTTP security headers (server.mjs) ───────────────────────────────────────
# Every response carries X-Content-Type-Options: nosniff, Referrer-Policy:
# strict-origin-when-cross-origin and a Content-Security-Policy. App pages may
# be framed only by the app itself (frame-ancestors 'self', X-Frame-Options:
# SAMEORIGIN); the embed pages (/embed/...) and published dashboards
# (/share/bi/...) may be framed anywhere unless EMBED_FRAME_ANCESTORS narrows
# them. HSTS is sent when the browser came over HTTPS (directly, or through a
# proxy that sends X-Forwarded-Proto: https).
SECURITY_HEADERS=""                # on; "off" when a proxy in front sets them
# The enforced policy. Default: object-src 'none'; base-uri 'self';
# form-action 'self'; script-src 'self' 'nonce-{nonce}'. Scripts run only from
# this origin, plus the inline ones the app renders with that response's
# nonce: no 'unsafe-inline', no eval. In a policy you write, {nonce} is
# replaced by each response's nonce; keep 'nonce-{nonce}' in any script-src,
# or the page's own hydration scripts are refused. frame-ancestors is set per
# page and is ignored here. Two worker scripts carry their own script-src
# whatever you set: DuckDB's engine ('self' 'wasm-unsafe-eval') and the swarm
# function node's sandbox (default-src 'none'; script-src 'unsafe-eval').
# To go back to no script-src (an inline tag your proxy injects, say), set
# "object-src 'none'; base-uri 'self'; form-action 'self'".
CONTENT_SECURITY_POLICY=""
# A policy to TRIAL: the browser reports what it would block and blocks
# nothing. {nonce} works here too, e.g.
#   "script-src 'self' 'nonce-{nonce}'; report-uri https://csp.example.com/r"
CONTENT_SECURITY_POLICY_REPORT_ONLY=""
# Who may frame the embed and share pages, e.g.
#   "https://www.example.com https://help.example.com"
EMBED_FRAME_ANCESTORS=""
HSTS_MAX_AGE=""                    # 15552000 (180 days); 0 sends no HSTS
HSTS_INCLUDE_SUBDOMAINS=""         # false
# The Permissions-Policy header on every response. The default denies, for
# every origin, browser features the app never uses (camera, microphone,
# geolocation, payment, USB, motion sensors, screen capture), so neither an
# injected script nor a widget framed on an embed page can reach them. Set
# your own list to change it. Keep the line commented out for the default:
# an empty value sends no Permissions-Policy header at all.
# PERMISSIONS_POLICY="accelerometer=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"

# ── Audit trail ──────────────────────────────────────────────────────────────
# Retention is set per-instance in the DB (iam_settings.audit_retention_days,
# default 365). Before deleting expired rows the purge writes them to stdout as
# NDJSON lines prefixed `audit-archive`, so any log shipper keeps a copy after
# the database copy is gone.
#
# Set to 0/false to skip that — e.g. if you already pull the trail via
# GET /api/audit/export (NDJSON, superadmin bearer token, ?stream=audit|traces|runs
# with optional &since=&until=), which is the better route for SIEM ingestion.
AUDIT_ARCHIVE_ON_PURGE=""

# ── Prometheus / OpenMetrics scrape endpoint ─────────────────────────────────
# GET /api/metrics exposes fleet-level operational gauges (run/trace volume,
# error mix, month-to-date spend, active users) in the Prometheus text
# exposition format, for Prometheus / Grafana Agent / the Datadog OpenMetrics
# check. It aggregates ALL tenants, so it is DISABLED unless you set a token:
# leave this empty and the endpoint returns 404. When set, scrapers must send
# `Authorization: Bearer <this>`. Generate one with e.g. `openssl rand -hex 32`.
# The payload is cached ~15s per instance, so scrape as often as you like.
METRICS_TOKEN=""

# ── OpenTelemetry trace export (OTLP/HTTP) ───────────────────────────────────
# Stream multi-agent runs and LLM calls to any OTLP collector — the Datadog
# Agent's OTLP receiver, Grafana Tempo, Jaeger, or otelcol — as distributed
# traces. DISABLED unless an endpoint is set. A background job on the scheduler
# pass reads newly-finished swarm runs (root span + a child span per node, so
# you get the full waterfall) and execution traces (one span per LLM call, with
# OpenTelemetry GenAI `gen_ai.*` attributes) and POSTs them. It's fully
# decoupled from the request path, so it can never slow or break a live call,
# and only span METADATA is sent (model, tokens, cost, status, timing, node
# graph) — never prompt/response text — so it carries no user content.
#
# Base collector endpoint; the exporter appends /v1/traces. e.g. an in-cluster
# collector: http://otel-collector:4318  (or the Datadog Agent: http://datadog-agent:4318)
OTEL_EXPORTER_OTLP_ENDPOINT=""
# Optional: full traces URL instead of the base above (takes precedence).
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=""
# Optional: extra headers as comma-separated key=value pairs — e.g. an API key
# for a hosted collector: "dd-api-key=xxxxx" or "authorization=Bearer xxxxx".
OTEL_EXPORTER_OTLP_HEADERS=""
# Optional: service.name on the exported resource (default "agentswarms").
OTEL_SERVICE_NAME=""

# Persist prompt/response bodies in traces (default true). Set to false for
# regulated tenants that cannot keep user content at rest: traces and swarm-run
# steps then store the full operational skeleton — model, provider, tokens,
# cost, latency, status, node graph, tool-call shape — but drop the prompt,
# response, node input/output and chain-of-thought text. Applies at write time
# only (not retroactive); pair with trace_retention_days for older rows.
PERSIST_PROMPT_BODIES=""

# ── Local SQL engine (uploaded datasets, prep flows, BI, semantic models) ────
# SQL over LOCAL datasets — everything you upload, plus prep flows, BI widgets,
# semantic models and the agents' sql_query tool — runs in-process. You need
# NONE of this to run the app.
#
# Leave EMPTY. The default is DuckDB, a columnar engine with real SQL: CTEs,
# window functions, subqueries and proper JOINs.
#
# Set to `alasql` ONLY as an escape hatch, if the native module will not install
# on your platform. AlaSQL is a JS interpreter with no window functions, no
# CTEs and no subqueries, so the semantic layer's period-over-period comparisons
# do not work on it. Any other value is treated as the default, so a typo cannot
# silently downgrade your engine.
#
# Behaviour differences are small but real and are written down rather than
# discovered — see docs/TESTING.md. The two notable ones: DuckDB sorts NULLs
# last in both directions, and it rejects backtick-quoted identifiers.
LOCAL_ENGINE=""
# Per-query ceilings for DuckDB, shown with their defaults. Ignored when you
# have opted out with LOCAL_ENGINE=alasql; leave blank to keep the default.
LOCAL_ENGINE_MEMORY_MB=""     # 512
LOCAL_ENGINE_THREADS=""       # 2
LOCAL_ENGINE_TIMEOUT_MS=""    # 30000
#
# Columnar mirror: DuckDB can read a dataset from a cached Parquet copy instead
# of its rows, which makes a large dataset's repeat queries much faster (8 ms
# against 20 ms on 5,000 rows, and the gap widens with size). On by default;
# set to 0 to disable. The mirror is a strict cache — it is used only while it
# is newer than the data, and NEVER for a SHARED dataset, because a mirror
# holds unmasked rows and a stale one would serve a revoked grantee. Shared
# datasets always read their rows directly, which is correct and fast enough.
PARQUET_MIRROR=""
# Smallest dataset worth mirroring, and the cache's disk budget.
PARQUET_MIN_ROWS=""           # 5000
PARQUET_CACHE_MAX_BYTES=""    # 2 GiB
# Largest dataset `auto` will mirror. Above this a dataset stays on direct
# query rather than letting one table consume the whole budget. A dataset set
# explicitly to `import` ignores this — an explicit choice outranks a heuristic.
PARQUET_MAX_ROWS=""           # 5000000
#
# How many bytes of mirrors ONE WORKSPACE may hold. Blank or 0 = unlimited,
# which is the default and means nothing is ever evicted for capacity.
#
# Distinct from PARQUET_CACHE_MAX_BYTES above: that bounds one node's scratch
# directory and evicts by file age; this bounds how much of a workspace's data
# is materialised at all and evicts by last USE, keeping datasets pinned to
# `import` until every `auto` one has gone. Eviction only ever removes a cache
# — an evicted dataset still answers the same question from its rows, more
# slowly — and the owner is told which datasets went.
MIRROR_BUDGET_BYTES=""        # unlimited
# Defaults to a subdirectory of the system temp dir. Set this to keep the cache
# on a specific volume, or to survive restarts on a host with a volatile /tmp.
#
# NOTE: this is also the ONLY directory the local SQL engine may touch. It is
# passed to DuckDB's allowed_directories, so user- and model-authored SQL can
# read the mirror and nothing else on the host. See SECURITY.md.
PARQUET_CACHE_DIR=""

# Largest ORC object read from a bucket, in bytes. Default 268435456 (256 MB).
# ORC is the one format DuckDB cannot stream from object storage — read_orc
# opens local paths only — so the whole file is downloaded first. A partial
# download is unreadable (the footer is at the end), so a file over this
# ceiling is refused with its size rather than fetched and then failed.
ORC_MAX_DOWNLOAD_BYTES=""     # 268435456

# Dataset uploads: the largest file accepted, in bytes (default 100 MB), and
# the most rows. Going over either refuses the upload; a subset is never
# imported. CSV, TSV and NDJSON stream in batches, but JSON arrays and .xlsx
# are read whole, so the byte cap is also their memory cost. Past these, a
# database connection serves the data better than a bigger file.
# UPLOAD_MAX_BYTES=104857600
# UPLOAD_MAX_ROWS=500000
# Data-prep flows run on the server over the full data. The rows loaded from
# each source table, and the rows written to the output dataset. Hitting
# either is reported on the flow (which source, how many rows), never
# silently. Rows are held in memory during a run, so raise these with the
# app's memory in mind.
# PREP_SOURCE_ROWS_CAP=500000
# PREP_OUTPUT_ROWS_CAP=250000
# Rows one uploaded dataset may contribute when the server runs SQL over a
# user's datasets without a current Parquet mirror: scheduled dashboard
# refreshes, data alerts and semantic-model queries among them. A dataset
# shared with the user never uses a mirror, so this always applies to it.
# Only the datasets a query names are loaded. A query that reads one over the
# cap fails rather than answer from its first rows; queries that do not read
# it are unaffected. Turn PARQUET_MIRROR on, or raise this and the app's
# memory with it.
# BI_LOCAL_ROWS_PER_TABLE_CAP=20000
# Data quality checks run after each prep refresh and on the scheduler. How
# often a dataset with enabled checks is re-checked, in minutes (also how
# soon a freshness SLA can alert); the rows one check reads (a capped read
# says so in its result, and suites of only row-count and load-time checks
# read no rows); and how many results are kept per dataset, newest first.
# DATA_QUALITY_INTERVAL_MINUTES=60
# DATA_QUALITY_ROW_CAP=200000
# DATA_QUALITY_KEEP_RESULTS=500
# Before anything overwrites a dataset (a re-upload, a prep run or refresh, a
# restore) its rows are copied as a version you can restore. A dataset with
# more rows than the cap gets a version with metadata only, marked as not
# restorable; 0 keeps metadata only for every dataset. Each version is a full
# copy, so raise the cap with storage in mind. The keep count is versions kept
# per dataset. An empty value is the default, for both.
# DATASET_VERSION_ROW_CAP=20000
# DATASET_VERSION_KEEP=5

# ── External data connections (warehouses + app sources) ─────────────────────
# NONE of this is required. The defaults are the recommended settings; these
# exist for tuning against a specific warehouse or network. Full explanations,
# including how the numbers were measured, are in docs/DEPLOYMENT.md.

# Per-query ceilings and concurrency for every warehouse query the app makes.
WAREHOUSE_MAX_ROWS=""                 # 1000  — default rows returned
WAREHOUSE_ABS_MAX_ROWS=""             # 5000  — hard ceiling, no caller exceeds
WAREHOUSE_QUERY_TIMEOUT_MS=""         # 60000
WAREHOUSE_MAX_CONCURRENT=""           # 8     — in flight per instance
WAREHOUSE_MAX_CONCURRENT_PER_USER=""  # 3
WAREHOUSE_QUEUE_TIMEOUT_MS=""         # 30000 — wait for a slot before failing

# Connection pooling for PostgreSQL/MySQL-family connections. Measured on a
# local Postgres, opening a connection was 92% of a SELECT 1 (24.9ms of
# 27.1ms); pooling took the driver from 30.7ms to 2.9ms per query. Reproduce
# with `npx vite-node scripts/bench-pool.ts`. Set WAREHOUSE_POOL=off to go
# back to a connection per query.
#
# SIZING: sockets held ≈ WAREHOUSE_POOL_MAX x WAREHOUSE_POOL_MAX_KEYS x
# replicas. Check that against your database's max_connections.
WAREHOUSE_POOL=""                     # on
WAREHOUSE_POOL_MAX=""                 # 4     — sockets per credential set
WAREHOUSE_POOL_IDLE_MS=""             # 30000 — before an idle socket closes
WAREHOUSE_POOL_TTL_MS=""              # 300000 — before a whole pool is dropped
WAREHOUSE_POOL_MAX_KEYS=""            # 64    — distinct credential sets held

# Outbound HTTP for warehouse APIs and app sources (Stripe, Sheets, CRMs).
#
# PROXY: if your network has no direct egress, set these and the connectors
# will use them. Without it the product cannot reach Snowflake or Stripe from
# inside such a network, and it looks like a timeout rather than a setting.
# NO_PROXY takes a comma-separated bypass list: `*` bypasses everything,
# `internal.corp` matches that host and its subdomains, `db.corp:5432` only
# that port. Lower-case spellings are accepted too.
HTTPS_PROXY=""
HTTP_PROXY=""
NO_PROXY=""
# One proxy for every scheme, used where the scheme's own variable is empty
# or unset: an https target takes HTTPS_PROXY, then https_proxy, then this,
# then all_proxy (an http target the same with HTTP_PROXY), and an empty
# NO_PROXY gives way to no_proxy the same way. NO_PROXY applies to it too.
# ALL_PROXY=

# PRIVATE CONNECTIVITY FOR MODEL PROVIDERS. The proxy above also covers every
# LLM provider call. Each provider integration can be set to "Require a private
# network path": its calls are refused unless the endpoint resolves to a private
# address here or goes through the proxy, so a missing private DNS zone fails
# loudly instead of sending traffic over the internet. This sets the switch's
# starting value for NEW integrations only; it never changes an existing one.
GENAI_REQUIRE_PRIVATE=""

# RETRIES on transient failures (408/429/502/503/504 and transport errors),
# with exponential backoff, full jitter, and Retry-After honoured when sent.
CONNECTOR_MAX_RETRIES=""              # 2 (max 5; 0 disables)
CONNECTOR_RETRY_BASE_MS=""            # 400
CONNECTOR_RETRY_MAX_MS=""             # 8000 — caps any single wait
# 500 is NOT retried by default: it usually means the query reached the
# backend and failed there, so a retry pays for the same scan twice. Turn on
# for a provider that returns 500 for throttling.
CONNECTOR_RETRY_500=""                # off

# Scheduled re-validation of connection credentials, using the product's own
# probes (a SELECT 1 through the real driver; the same stream listing the
# "test" button makes). Advisory only — nothing is auto-disabled, and a
# failure notifies once per transition rather than every pass.
CONNECTION_HEALTH_HOURS=""            # 12 (0 disables)
# The same for Integration Hub credentials: LLM provider keys, the LLM
# gateway, n8n and Firecrawl are re-tested this often, in hours (decimals
# work), with the same test their save runs. A key that starts or stops
# failing gets a badge, an in-app notification and an audit event; nothing is
# disabled. At most 10 checks a pass. 0, off, false or no turns it off.
# INTEGRATION_HEALTH_HOURS=6
# Age at which a credential is badged as old in the Integrations UI. Measured
# from when the secret was last entered, so re-saving resets it and a health
# check does not. Nothing expires.
CREDENTIAL_MAX_AGE_DAYS=""            # 90

# ── Budget enforcement ───────────────────────────────────────────────────────
# /budgets stores a monthly_cap_usd per user, but by default it only drives
# threshold ALERT emails — spend is never actually blocked.
#
# Set to true to make the cap a hard stop: once month-to-date spend reaches it,
# model calls return 402 until the next month or the cap is raised. Off by
# default because monthly_cap_usd defaults to a very small value, so enabling
# it on an existing instance whose caps were never meant to bite would start
# refusing calls immediately. Review your caps, then turn this on.
ENFORCE_BUDGET_CAP=""

# ── Scheduling & horizontal scaling ──────────────────────────────────────────
# AgentSwarms runs a lightweight in-process scheduler on a 60s tick: BI
# refreshes, data alerts, scheduled reports, swarm schedules, catalog crawls,
# and notebook-kernel reaping. On a SINGLE instance you need nothing here.
#
# Token so an EXTERNAL scheduler can drive the same work by POSTing to
# /api/bi/cron with `Authorization: Bearer <this>`. Recommended once you run
# more than one instance.
BI_CRON_TOKEN=""
# The same token lets that scheduler refresh the Model Registry from AIMLAPI by
# POSTing to /api/public/hooks/refresh-model-registry (a superadmin's session
# works too). At most this many refreshes run a minute; extra calls get 429.
MODEL_REGISTRY_SYNC_PER_MIN=""   # 2
# Models the Model Registry page loads, read in pages of 1,000 (a value under
# 1000 counts as 1000). Past it the page says it shows the first N of M
# models, and its filters and search cover only those. Raise it once the
# registry outgrows it.
# MODEL_REGISTRY_MAX_ROWS=5000
# Set to 1 on the replicas that should NOT run the in-process scheduler, e.g.
# the web tier when analytics nodes run it, or every replica when ONE external
# cron hits /api/bi/cron (see docs/DEPLOYMENT.md). A cross-instance lease
# already makes it safe to run on many, so this is hygiene, not correctness.
# Leave empty for single-instance and local runs.
DISABLE_INPROCESS_SCHEDULER=""
# That lease: how long a pass may hold it before another replica can take over.
# It is renewed while the pass runs, so this is only how long a crashed holder
# blocks scheduled work. Minimum 30 s.
SCHEDULER_LEASE_TTL_MS=""   # 120000 (2 min)
# Where the production server listens. Read by `node server.mjs`, which the
# Docker image and `npm start` run; `npm run dev` listens on 8080 from
# vite.config.ts instead. Defaults 0.0.0.0 (every IPv4 interface) and 8080.
# Inside a container keep HOST as it is; on a bare host, 127.0.0.1 leaves the
# app reachable only through a reverse proxy on the same machine. Under
# Compose leave PORT alone too: the port mapping and the health check both
# name 8080. Elsewhere, such as a platform that sets PORT for you, the app's
# calls to its own /api/chat follow PORT unless PUBLIC_APP_URL or SITE_URL
# is set, as notebook kernels' default callback address does. Do not set
# PORT for `npm run dev`: Vite stays on 8080, and those calls would go to the
# port PORT names.
# HOST=0.0.0.0
# PORT=8080
# How many worker processes `node server.mjs` runs. Unset: one per CPU the
# process may use, which in a container is its CPU quota rounded down (at
# least 1), and 1 on an analytics node (APP_ROLE below). 0 or 1 runs one
# process with no cluster, which suits many one-core containers; a number
# caps it, for a noisy neighbour. Each worker has its own lakehouse engine
# and catalog sessions, so LAKEHOUSE_MEMORY_LIMIT and
# LAKEHOUSE_CATALOG_CONNECTIONS count once per worker. The startup log gives
# the count ("forking N workers", or "single process"). deploy/aws and the
# Helm chart set it per tier.
# WEB_CONCURRENCY=
# `analytics` keeps this node out of the request path: /api/health/ready
# answers 503 for good while /api/health stays 200, so a load balancer that
# checks readiness stops sending it traffic and nothing restarts it. It still
# runs scheduled work (unless DISABLE_INPROCESS_SCHEDULER is set) and answers
# requests sent to it directly, and WEB_CONCURRENCY defaults to 1 there. Use
# it for nodes sized for heavy lakehouse queries. Any other value is `web`.
# On Kubernetes give an analytics Deployment no readiness probe, or its
# rollout never completes. docs/DEPLOYMENT.md, "Analytics-only nodes".
# APP_ROLE=web

# ── Shutdown and connection timing (behind a load balancer) ──────────────────
# See docs/DEPLOYMENT.md "Shutdown and connection timing". The defaults suit an
# AWS ALB or a Kubernetes Service; change them only to match yours.
# After SIGTERM, how long open requests (a chat reply mid-stream) get to finish.
DRAIN_TIMEOUT_MS=""            # 25000
# Keep accepting this long after SIGTERM while readiness already answers 503.
DRAIN_DELAY_MS=""              # 0
# Idle keep-alive window: keep it ABOVE your load balancer's idle timeout.
HTTP_KEEPALIVE_TIMEOUT_MS=""   # 75000
# A quiet streamed reply gets a `: ka` comment this often (0 = off).
SSE_HEARTBEAT_MS=""            # 15000
# Behind a proxy that gives up on a first byte (CloudFront: 60 s), a chat turn
# not answered by then sends its headers first and its answer, or its error, as
# events. Off when empty; deploy/aws sets 45000 behind CloudFront (R481).
EARLY_HEADERS_AFTER_MS=""

# ── Server-side PowerPoint renderer (optional, Node/Docker only) ──────────────
# By default, PPT/Word/Excel are generated IN THE BROWSER (pptxgenjs) — works on
# every deploy, nothing to configure. Optionally run the `docgen` container (python-pptx → NATIVE editable charts/tables, and the
# slide images Deep mode's review reads; the review itself runs in the app, as the user) and point the app at it:
#
#   docker compose --profile docgen up -d --build
#
# You can leave this EMPTY: the app probes http://docgen:8099 (compose network)
# and http://localhost:8099 (published loopback port) and uses whichever answers,
# so both of these work without configuration:
#
#   Docker stack (app in a container)  →  reached as http://docgen:8099
#   Local dev server (npm run dev)     →  reached as http://localhost:8099
#
# Set it only when the renderer runs somewhere else (another host, another port).
# A value that doesn't answer is not fatal — the probe falls back to the two
# names above, so a stale setting can't silently disable Deep mode.
#
# "Deep" mode uses the service and falls back to the in-browser generator if it
# is unreachable — which produces a file IDENTICAL to "Browser · fast". The
# composer greys out Deep and says why when it can't be reached
# (GET /api/docgen/status).
DOCGEN_SERVICE_URL=""
# Optional shared bearer token between the app and the docgen container (set the
# same value on both). Leave empty for a private in-network service.
DOCGEN_TOKEN=""

# ── Developer workspace: server-side Python runtime ───────────────────────────
# NOTHING HERE IS REQUIRED unless you want the Developer-workspace server
# runtime — real server kernels that pip install and run LangChain / LlamaIndex
# / LangGraph. Enable it with:
#
#   docker compose --profile notebooks up -d --build
#
# then enable it under Admin → Developer runtime. The app generates its own
# signing secret and defaults every internal URL to the compose service names.
# Security model + scaling: docs/DEVELOPER_WORKSPACE_RUNTIME.md.
#
# The settings below are OPTIONAL overrides for non-standard deployments.
#
# Force-enable without using the admin UI (the DB setting is the normal switch):
NOTEBOOK_RUNTIME_ENABLED=""
# Manage the token-signing secret yourself instead of letting the app generate
# one (min 16 chars). Only needed if you run replicas that don't share a DB.
NOTEBOOK_RUNTIME_SECRET=""
# Backend: docker (single host) | k8s (app must run IN-cluster) | ecs (one
# Fargate task per sandbox, on AWS) | e2b (stub).
NOTEBOOK_RUNTIME_BACKEND="docker"
# ecs: deploy/aws sets every NOTEBOOK_ECS_* below (Terraform's ecs and vm
# stacks) and registers the task definition: the image, a read-only root, no
# task role, and subnets with no route out. RunTask cannot change the image,
# so this backend runs the task definition's image and ignores
# NOTEBOOK_RUNTIME_IMAGE. The app's role needs ecs:RunTask, ecs:TagResource,
# ecs:DescribeTasks, ecs:StopTask, ecs:DescribeClusters, iam:PassRole on the
# sandbox's execution role, and logs:GetLogEvents; deploy/aws grants exactly
# these. A sandbox gets its secrets from the app once, for a one-time nonce,
# never in RunTask's request (which CloudTrail records), so it needs
# NOTEBOOK_APP_INTERNAL_URL (below) to reach the app. AWS_REGION (or
# AWS_DEFAULT_REGION) is required too. See docs/DEVELOPER_WORKSPACE_RUNTIME.md.
#
# Required on ecs: without them no sandbox starts, and the error names the
# missing ones. The cluster is a name or ARN, the task definition a family,
# family:revision or ARN. Subnets (at most 16) and security groups (at most
# 5) are comma-separated ids. Sandboxes never get a public IP.
# NOTEBOOK_ECS_CLUSTER=
# NOTEBOOK_ECS_TASK_DEFINITION=
# NOTEBOOK_ECS_SUBNETS=
# NOTEBOOK_ECS_SECURITY_GROUPS=
# ecs: other task definitions for batch jobs (ETL runs, ML training and
# prediction, workflow notebook steps, lakehouse Spark queries) and for
# long-running services (MCP servers, model scorers). Unset = the task
# definition above.
# NOTEBOOK_ECS_TASK_DEFINITION_BATCH=
# NOTEBOOK_ECS_TASK_DEFINITION_SERVICE=
# ecs: the capacity provider for notebook sessions and services, and the one
# for batch jobs (unset = the first). deploy/aws sets FARGATE and
# FARGATE_SPOT, so batch jobs run on Spot capacity.
# NOTEBOOK_ECS_CAPACITY_PROVIDER=FARGATE
# NOTEBOOK_ECS_BATCH_CAPACITY_PROVIDER=
# ecs: the sandbox's container name in the task definition. RunTask's
# overrides go to it, and the exit code and log stream are read from it.
# deploy/aws names it kernel too.
# NOTEBOOK_ECS_CONTAINER=kernel
# ecs: where the task definition's awslogs driver writes, so the app can read
# a job's output back: the last 2000 lines of the stream
# <prefix>/<container>/<task id>. With no log group that output is empty and
# the runtime's preflight check warns. deploy/aws sets both.
# NOTEBOOK_ECS_LOG_GROUP=
# NOTEBOOK_ECS_LOG_STREAM_PREFIX=nb
# ecs: the ECS and CloudWatch Logs API endpoints, for VPC endpoints or an
# emulator. An http(s) URL, of which only the origin is used. Unset =
# AWS_ENDPOINT_URL, then https://ecs.<region>.amazonaws.com and
# https://logs.<region>.amazonaws.com (the -fips hosts when
# AWS_USE_FIPS_ENDPOINT is true).
# AWS_ENDPOINT_URL_ECS=
# AWS_ENDPOINT_URL_LOGS=
# The egress proxy's container name. The app restarts it by this name when an
# admin saves a new allow-list, and compose names it the same way, so change
# both or neither — it is one variable for exactly that reason. Change it when
# two instances share a host, where a fixed name collides. Default
# agentswarms-notebook-egress.
NOTEBOOK_EGRESS_CONTAINER=""
# "pull" where the app can neither write the proxy's files nor restart it (ECS,
# EKS): the egress-proxy image fetches the allow-list from the app every 30 s
# instead, with this token (32+ characters; deploy/aws generates it and hands
# the proxy the same one). Empty = Compose's way, above.
NOTEBOOK_EGRESS_MODE=""
NOTEBOOK_EGRESS_PULL_TOKEN=""
# Spark engine (chosen per pipeline: Settings -> Engine). Compose ships the
# cluster (service: spark-connect) and this points at it; replace it with a
# cluster of your own where you have one. Empty = the Spark engine is
# unavailable and the picker says so. Also editable under Admin -> Developer
# runtime.
SPARK_CONNECT_URL="sc://spark-connect:15002"   # or sc://host:15002;token=...
# Pre-shared token the Compose spark-connect server requires (VA-23). setup.sh
# generates one; the server enforces it (SPARK_CONNECT_AUTHENTICATE_TOKEN) and
# the app hands the same value to every run, so a notebook kernel cannot drive
# the Spark driver without it. Empty = no auth (an existing install keeps
# working). Ignored when the token rides in SPARK_CONNECT_URL as ;token=…
# instead, or for a managed cluster that does its own auth.
SPARK_CONNECT_TOKEN=""
# Where a Spark-engine run's cluster comes from: "static" uses the endpoint
# above for every run; "k8s" creates a driver and its executors per run and
# deletes them when it ends (needs the app in-cluster, plus
# deploy/k8s/spark/spark-runtime.yaml). Sizing is in Admin -> Developer runtime,
# or SPARK_EXECUTORS / SPARK_EXECUTOR_CORES / SPARK_EXECUTOR_MEM_MB /
# SPARK_DRIVER_MEM_MB. See docs/ETL_PIPELINES.md.
SPARK_PROVIDER="static"
SPARK_IMAGE=""                          # k8s: driver + executors; default apache/spark:4.1.4-python3@sha256:… (the Connect server's pin)
SPARK_PACKAGES=""                       # unset = resolve the connectors; empty string = the image already has them
# Per-run cluster size when SPARK_PROVIDER is k8s: executor pods per run,
# cores and memory (MB) per executor, and driver memory (MB). The driver pod
# requests that memory and is limited to 1.4 x it + 512 MB. Admin ->
# Developer runtime wins over these; unset, 0 or not a number = the default.
# The static provider uses none of them: size that cluster where it runs.
# SPARK_EXECUTORS=2
# SPARK_EXECUTOR_CORES=1
# SPARK_EXECUTOR_MEM_MB=2048
# SPARK_DRIVER_MEM_MB=2048
# k8s: the namespace each run's driver pod is created in, and the
# ServiceAccount it runs as (the driver asks the API server for its
# executors). deploy/k8s/spark/spark-runtime.yaml creates both under these
# names and lets the app's ServiceAccount manage pods and services there.
# SPARK_K8S_NAMESPACE=agentswarms-spark
# SPARK_K8S_SERVICE_ACCOUNT=spark-driver
# k8s: how long a run waits, in seconds, for its driver to answer on the
# Spark Connect port before the run fails and the cluster is deleted.
# Resolving SPARK_PACKAGES on first start is usually the slow part. The same
# time is added to the driver pod's activeDeadlineSeconds.
# SPARK_K8S_STARTUP_TIMEOUT_SECONDS=420
# k8s: the driver pod's CPU request and limit (Kubernetes quantities), and the
# size limit of its /tmp volume. Its root filesystem is read-only, so the Ivy
# cache, the Spark logs and anything else the driver writes go there.
# SPARK_K8S_DRIVER_CPU_REQUEST=500m
# SPARK_K8S_DRIVER_CPU_LIMIT=2
# SPARK_K8S_DRIVER_SCRATCH=8Gi
# k8s: the driver pod's uid (also its gid and fsGroup; 185 is the apache/spark
# image's user), the image pull policy, and where the driver may be
# scheduled: a JSON node selector object and a JSON tolerations array
# (invalid JSON is logged and ignored). Spark creates the executors. The pull
# policy reaches them too (as spark.kubernetes.container.image.pullPolicy:
# one image, one policy). The other three shape the DRIVER pod only: Spark has
# no setting for an executor's tolerations or user, and a node selector
# without its tolerations would leave executors Pending on a tainted pool. Put
# executors' placement and user in the executor pod template below.
# SPARK_K8S_RUN_AS_USER=185
# SPARK_K8S_PULL_POLICY=IfNotPresent
# SPARK_K8S_NODE_SELECTOR=
# SPARK_K8S_TOLERATIONS=
# k8s: more Spark settings for every per-run cluster, as comma-separated
# key=value pairs. Each becomes a --conf after the platform's own, so a value
# cannot contain a comma. For example:
#   spark.sql.shuffle.partitions=64,spark.executor.memoryOverhead=1g
# SPARK_K8S_EXTRA_CONF=
# k8s: an executor pod template, passed to Spark as
# spark.kubernetes.executor.podTemplateFile. Needed where the Spark namespace
# enforces the `restricted` Pod Security Standard, or to place executors.
# The driver reads it from its own filesystem. Name a ConfigMap in the Spark
# namespace and every driver pod mounts it at /opt/spark/executor-template;
# the template is then that ConfigMap's executor.yaml key, unless
# SPARK_K8S_EXECUTOR_POD_TEMPLATE gives another path. spark-runtime.yaml
# creates one called spark-executor-template. Without the ConfigMap, the path
# must already exist in SPARK_IMAGE.
# SPARK_K8S_EXECUTOR_POD_TEMPLATE_CONFIGMAP=
# SPARK_K8S_EXECUTOR_POD_TEMPLATE=
# The sandbox image kernels start from. Leave empty: Compose then names (and
# builds or pulls) ghcr.io/agentswarms-fyi/notebook-runtime:<AGENTSWARMS_VERSION>
# and hands the app that name. Older installs had agentswarms/notebook-runtime:latest
# here, a Docker Hub name nobody here owns; clear it (R470).
NOTEBOOK_RUNTIME_IMAGE=""
# Public websocket URL browsers use to reach the gateway. Change this if the
# gateway isn't on localhost:8090 (e.g. behind a domain: wss://nb.example.com).
NOTEBOOK_GATEWAY_URL="ws://localhost:8090"
# Token for the reaper cron endpoint (/api/notebook/runtime/reap). Falls back to
# BI_CRON_TOKEN if unset.
NOTEBOOK_CRON_TOKEN=""
# docker: where the app reaches the Docker socket-proxy that starts kernels.
# Unset, it tries http://notebook-docker-proxy:2375 (the Compose service),
# then http://127.0.0.1:2375 (an app run on the host with its own proxy; see
# docs/DEPLOYMENT.md). A value here is tried first. The first address that
# answers /_ping is kept until the app restarts.
# DOCKER_PROXY_URL=
# docker: how long one /_ping may take, in ms, for each address tried. A
# daemon busy with a build or pull answers slowly (13 s seen live); too short
# and every run fails with "Cannot reach the Docker socket-proxy" while the
# services are up. 0 or not a number = 10000.
# DOCKER_PROXY_PING_TIMEOUT_MS=10000
# docker: when two teardowns of one sandbox overlap, Docker answers the second
# "removal ... already in progress". The second waits this long, in ms, for
# the container to go before reporting it still there.
# NOTEBOOK_TEARDOWN_WAIT_MS=10000
# docker: the network kernels join. Unset: agentswarms_nb-internal (no way
# out but the egress proxy) when the app runs in a container,
# agentswarms_nb-dev when it runs on the host; docker-compose.yml creates
# both. Another network must be a user-defined one the notebook gateway also
# joins, never `bridge`. One with a route out leaves egress control to the
# sandbox's HTTP(S)_PROXY variables alone, as on the host-run dev path.
# NOTEBOOK_NETWORK=agentswarms_nb-internal
# docker: the uid:gid kernels run as; the runtime image's non-root user is
# 1000:1000. Change it only for an image built with another user. Kubernetes
# sandboxes always run as 1000, and ECS ones as the task definition says.
# NOTEBOOK_RUN_USER=1000:1000
# Every backend: the URL a sandbox calls the app on (for model and
# knowledge-base calls, to report batch results, and on ecs to fetch its
# environment), with no trailing slash. Its host goes in the sandbox's
# NO_PROXY, so the sandbox must reach it directly. Unset: APP_URL, then
# http://agentswarms:<PORT> when the app runs in a container or
# http://host.docker.internal:<PORT> when it runs on the host (PORT defaults
# to 8080). Those defaults are Docker names: Helm, deploy/k8s and deploy/aws
# set it, and on ecs the runtime's preflight check fails without it. APP_URL is only this
# fallback, an INTERNAL address, not the public PUBLIC_APP_URL.
# NOTEBOOK_APP_INTERNAL_URL=http://agentswarms:8080
# APP_URL=
# Every backend: the HTTP(S) proxy each sandbox is given (HTTP_PROXY,
# HTTPS_PROXY), the egress proxy that enforces the allow-list. It cannot be
# turned off: empty means the default, the Compose service, which is also the
# Service name deploy/k8s/notebooks gives its proxy beside the sandboxes. Helm
# and deploy/aws set their own proxy's address.
# NOTEBOOK_EGRESS_PROXY=http://notebook-egress:3128
# Compose (NOTEBOOK_EGRESS_MODE empty): where the app writes the egress
# allow-list (allowed_domains, with allowed_ips beside it), as a path inside
# the APP's container, and the Docker API (an http URL, not a unix:// socket)
# it restarts the proxy through so squid re-reads them. It does this when an
# admin saves the list, and at job start when the deployment's own hosts are
# missing from it. Compose mounts deploy/notebooks/egress at
# /etc/agentswarms/egress in the app and at /etc/squid/egress in the proxy.
# To apply the list from an app run on the host, set the path to
# deploy/notebooks/egress/allowed_domains in your checkout and the API to
# http://127.0.0.1:2375. Neither is used when NOTEBOOK_EGRESS_MODE is pull.
# NOTEBOOK_EGRESS_ALLOWLIST_PATH=/etc/agentswarms/egress/allowed_domains
# NOTEBOOK_DOCKER_HOST=http://notebook-docker-proxy:2375
# k8s: the app must run in the cluster, with its ServiceAccount token mounted
# and NODE_EXTRA_CA_CERTS pointing at the cluster CA so it trusts the API
# server (Helm and deploy/k8s do both). This is the namespace sandbox pods
# and Jobs are created in. Unset: the app pod's own namespace, then
# agentswarms-notebooks; the runtime's preflight check uses the same order and
# warns when it is unset. deploy/k8s sets it to agentswarms-notebooks, the
# namespace its sandbox RBAC is in (the app itself is in agentswarms); Helm
# sets it to its sandboxes.namespace (agentswarms-sandboxes by default).
# NOTEBOOK_K8S_NAMESPACE=agentswarms-notebooks
# k8s: an optional RuntimeClass for every sandbox pod, such as gvisor (the
# cluster must define it; deploy/k8s/notebooks/notebook-runtime.yaml shows
# how), and the kernel container's image pull policy.
# NOTEBOOK_K8S_RUNTIME_CLASS=
# NOTEBOOK_K8S_PULL_POLICY=IfNotPresent
# k8s: the node pool every sandbox goes to: a JSON node selector object, and
# a JSON tolerations array that lets sandboxes past that pool's taint.
# Invalid JSON is logged and ignored. A GPU sandbox uses the GPU node
# selector instead when that is set, and adds the GPU tolerations to these
# (NOTEBOOK_K8S_GPU_NODE_SELECTOR, NOTEBOOK_K8S_GPU_TOLERATIONS). Helm sets
# both from sandboxes.nodeSelector and sandboxes.tolerations; deploy/aws's
# EKS stack fills those in as:
#   {"agentswarms.io/pool":"sandboxes"}
#   [{"key":"agentswarms.io/sandbox","operator":"Exists","effect":"NoSchedule"}]
# NOTEBOOK_K8S_NODE_SELECTOR=
# NOTEBOOK_K8S_TOLERATIONS=
# Browser-facing websocket port for the gateway. Change only if the gateway
# is not on :8090 — NOTEBOOK_GATEWAY_URL overrides this entirely.
VITE_NOTEBOOK_GATEWAY_PORT=""   # 8090
PUBLIC_NOTEBOOK_GATEWAY_PORT="" # the same, read at runtime (wins when set)
# Cell wall-clock limit enforced BY THE GATEWAY (services/notebook-gateway).
# The admin UI's cell_timeout_seconds is a separate value read by the app —
# change one and the gateway keeps using its own until you set this too.
NOTEBOOK_CELL_TIMEOUT_SECONDS=""  # 120
# How long the gateway waits for a session's kernel to be created, in ms. A
# slow first boot is waited for, never asked for twice: the container runs one
# kernel and would refuse a second (R322). Keep it under the browser's 30 s.
KERNEL_CREATE_TIMEOUT_MS=""  # 28000

# ── Rate limits and concurrency ──────────────────────────────────────────────
# All per app instance: behind a load balancer with N instances the effective
# ceiling is N x these. Enforce a hard global limit at your ingress if needed.
BI_DIRECT_QUERY_RATE_PER_MIN=""    # 120 — live warehouse queries, per dashboard OWNER
                                   #       (so many viewers of one shared dashboard
                                   #       cannot hammer the owner's warehouse)
MCP_RATE_LIMIT_PER_MIN=""          # 120 — requests per MCP API key
MCP_MAX_CONCURRENT_PER_SERVER=""   # 8   — in-flight calls per published MCP server
ETL_TRIGGER_PER_MIN=""             # 6   — external trigger calls per ETL pipeline
# Global cap on /api/etl/ingest requests per minute (default 600).
# ETL_INGEST_PER_MIN=600
# ETL throughput. Both are also editable under Admin -> Developer runtime,
# which takes precedence over these. Neither is capped by the application.
# ETL_MAX_CONCURRENT_RUNS_PER_USER=3
# ETL_PIPELINES_PER_SWEEP=3
# Continuous pipelines (Settings -> Schedule -> Continuous): one long-running
# run per pipeline. How long a run lives before it ends cleanly and the sweep
# starts the next (a bounded container lifetime), and how long the sweep
# waits before restarting a run that failed outright.
# ETL_CONTINUOUS_ROLLOVER_MINUTES=720
# ETL_CONTINUOUS_RESTART_BACKOFF_SECONDS=300

# Workflows (Data & BI -> Workflows): one graph over pipelines, SQL models, ML
# schedules and notebooks. The timeout is a BACKSTOP for a step whose sandbox
# vanished without reporting -- the work itself is capped by the pipeline,
# training job or notebook, not here. See docs/WORKFLOWS.md.
# WORKFLOW_STEP_TIMEOUT_MINUTES=240
# WORKFLOW_RUNS_PER_SWEEP=20
# WORKFLOW_TRIGGER_PER_MIN=6              # POST /api/workflows/run calls per workflow per minute

# How many reverse proxies of YOURS sit in front of the app. Used to find the
# real caller address in X-Forwarded-For, which an MCP key's IP allow-list is
# checked against. XFF is APPENDED to, so the entries your own proxies added are
# the only ones a caller cannot forge — this says how many to count back.
#   1  a single reverse proxy (the setup in docs/DEPLOYMENT.md) — default
#   2  a CDN in front of that proxy
# Too low reads your proxy's address instead of the caller's; too high reads a
# value the caller supplied, so it is clamped to the chain length.
TRUSTED_PROXY_HOPS=""              # 1

# What to do when a figure the budget cap depends on cannot be read: the
# month-to-date spend, a cap (personal, team or credential), or which teams the
# caller is in. Default (unset) allows the call: governance should not be the
# reason legitimate work breaks. Set true when the cap must hold even if a
# figure cannot be established; the refusal then says the budget could not be
# checked rather than that it was reached. The failure is logged either way.
BUDGET_FAIL_CLOSED=""              # false
UPLOAD_PER_MINUTE=""               # 10  — dataset uploads per user
CHAT_DOC_PER_MINUTE=""             # 30  — generated documents kept, per user
INTEGRATION_TEST_PER_MINUTE=""     # 10  — "Test connection" presses per user
SWARM_LEVEL_CONCURRENCY=""         # 4   — nodes run in parallel per graph level

# ── Contact form and GitHub ingestion ────────────────────────────────────────
# Where the marketing-site contact form sends its admin notification. Never
# exposed to the client. Without it the message is still stored, just not
# emailed.
CONTACT_ADMIN_EMAIL=""
# Raises the Knowledge Base GitHub importer's rate limit. Public repos work
# with no token at 60 requests/hour; a token lifts that to 5000 and allows
# private repos it can read.
GITHUB_TOKEN=""
# ── Skills in the prompt ─────────────────────────────────────────────────
# Total skill-body characters an agent may carry before skill bodies stop
# being inlined into the system prompt. Past this, the prompt gets an index
# (name + summary per skill) and the model loads a body on demand with the
# use_skill tool. Default 8000 — chosen so every bundled sample skill attached
# together still inlines. Raise to always inline; lower to defer sooner.
SKILLS_INLINE_MAX_CHARS=""

# The sql_query tool describes the user's tables inline so the model can write
# SQL without a round trip. Tables are listed with their columns until this many
# characters are spent, and by name with a column count after — list_data_tables
# has the rest. Default 4000 (~1,000 tokens); fifteen tables of forty columns
# unbudgeted were 4,300 tokens on every turn.
SQL_TOOL_SCHEMA_MAX_CHARS=""
# Rows one dataset may contribute when an agent's sql_query or
# list_data_tables tool loads the user's uploaded datasets. sql_query reads
# every row of each dataset its statement names, never a Parquet mirror, so a
# query that reads a dataset larger than this is refused with a message naming
# this setting rather than answered from its first rows; queries over other
# datasets still run. list_data_tables still lists a larger dataset, with its
# columns, no row count, and a note naming this setting. Raise it with the
# app's memory in mind.
# SQL_TOOL_MAX_ROWS=200000

# ── Lakehouse (built-in DuckLake warehouse) ──────────────────────────────────
# Transactional catalog: any Postgres the app AND every replica can reach.
# Compose ships one (service: lakehouse-catalog), and this points at it.
LAKEHOUSE_CATALOG_URL="postgres://lakehouse:change-me@lakehouse-catalog:5432/lakehouse_catalog"
# Both halves of the credential live here: the catalog container reads
# LAKEHOUSE_CATALOG_PASSWORD, the URL above carries the same value. Change
# them together (the installers generate one on a fresh .env). A URL with no
# password gets this one (deploy/aws and Helm keep it in a secret, apart).
LAKEHOUSE_CATALOG_PASSWORD="change-me"
# Catalog sessions one app WORKER may hold (default 8). Size the catalog's
# max_connections as this × workers × replicas, plus one per worker. Measured:
# a worker under 32 concurrent queries used 3.
LAKEHOUSE_CATALOG_CONNECTIONS=""
# Where table data (zstd Parquet) lives — an object-storage prefix all
# replicas share. Any S3-compatible store works (SILO, MinIO, S3, R2, GCS-S3).
# Compose ships SILO, a maintained MinIO fork (service: minio), and these point
# at it. For AWS S3,
# R2 or GCS: change the endpoint and credentials, omit the endpoint for AWS.
LAKEHOUSE_DATA_URL="s3://lakehouse/main"
LAKEHOUSE_S3_ENDPOINT="minio:9000"        # host:port of the object store, omit for AWS S3
LAKEHOUSE_S3_KEY_ID="agentswarms"
LAKEHOUSE_S3_SECRET="agentswarms-lake-dev"
LAKEHOUSE_S3_REGION="us-east-1"
LAKEHOUSE_S3_USE_SSL="false"
LAKEHOUSE_S3_URL_STYLE="path"             # path for SILO and MinIO; vhost for AWS
# Credentials. With LAKEHOUSE_S3_KEY_ID and LAKEHOUSE_S3_SECRET set, those keys
# (SILO, MinIO, R2, an IAM user). On AWS, leave BOTH empty and the app reaches
# the bucket as its own AWS identity: an ECS task role, IRSA or Pod Identity on
# EKS, an instance profile, or AWS_ACCESS_KEY_ID; those credentials are
# temporary and renewed five minutes before they expire. `chain` asks for that
# with any endpoint; `keys` insists on the keys. One key without the other, or
# keys together with `chain`, is refused rather than guessed at.
# LAKEHOUSE_S3_CREDENTIALS=
# Customer keys in AWS KMS (Admin -> IAM -> Settings) also have the store
# encrypt their members' lakehouse files under them (S3 SSE-KMS); on Cloud
# Storage, customer keys in Cloud KMS do (CMEK). auto (the default) is on for
# AWS S3 (no endpoint, or an amazonaws.com one) and for Cloud Storage
# (storage.googleapis.com, a regional or Private Service Connect endpoint),
# and off for any other store; on for an S3-compatible store that encrypts
# under KMS keys (MinIO with KES); off to turn it off. docs/KEY_MANAGEMENT.md,
# Lakehouse files.
LAKEHOUSE_SSE_KMS=""
#
# Sharing tables outside the platform (Delta Sharing). Recipients fetch
# governed snapshots through presigned URLs, so the bucket must be reachable
# from where they are: set the endpoint THEY reach when it differs from the
# one the app uses (the in-network store on minio:9000 is not routable from
# outside).
# LAKEHOUSE_S3_PUBLIC_ENDPOINT=data.example.com:9000
# SHARE_DATA_URL=s3://lakehouse/shares    # where snapshots are written; beside the lake, never inside its data path
# SHARE_URL_EXPIRY_SECONDS=3600           # how long a presigned file URL stays valid
# SHARE_RATE_LIMIT_PER_MIN=600            # requests a minute /api/delta-sharing accepts, all tokens together
# SHARE_MATERIALIZE_TIMEOUT_MS=600000     # the most one snapshot write may take
#
# Pipelines hold no lakehouse credential: the app reads their lakehouse
# sources and loads their targets for them (docs/SANDBOX_LAKEHOUSE_ACCESS.md).
# The most one such read or load may take before it is interrupted.
# LAKEHOUSE_SANDBOX_IO_TIMEOUT_MS=1800000
#
# The Spark cluster is the exception: its executors reach object storage
# themselves, so they get a credential the STORE limits to one run's files,
# through STS AssumeRole. SILO, MinIO and AWS S3 answer it; a store that does
# not (R2, GCS over its S3 endpoint) keeps the lakehouse's own credentials and
# says so in the log once. Set REQUIRED to refuse the run instead.
# LAKEHOUSE_STS_REQUIRED=false
# How long a scoped credential lasts. Default 12 h on SILO and MinIO, 1 h on
# AWS, where a role's maximum is an hour unless its owner raised it. When the
# app itself runs as a role (no keys, above), AWS refuses more than an hour
# (role chaining), so it is capped there whatever is set here.
# LAKEHOUSE_STS_DURATION_SECONDS=
# LAKEHOUSE_STS_ENDPOINT=               # defaults to the object store's own
# LAKEHOUSE_STS_ROLE_ARN=               # AWS needs a role to assume; SILO and MinIO do not
# Threads per query engine (default 4). No upper bound — set it to what the
# host can spare. Admin -> Developer runtime overrides this at runtime.
# LAKEHOUSE_THREADS=4
# Memory ceiling per query engine (default 2GB). Set this to roughly half the
# container's RAM: several requests can hold an engine at once. Admin ->
# Developer runtime overrides this at runtime, so you can retune without a
# redeploy.
# LAKEHOUSE_MEMORY_LIMIT=2GB
# Disk a query may spill to when it exceeds the memory limit (default 20GB).
# Without spill room a large GROUP BY or join FAILS instead of running slower,
# so the temp directory is always configured — this only bounds it.
# LAKEHOUSE_SPILL_LIMIT=20GB
#
# A SELECT can run on the Spark engine instead (the Query tab offers it when
# SPARK_CONNECT_URL or the per-job provider is set). How long one such query
# may hold the cluster, in minutes — the batch sandbox's own limit is sized
# for training jobs.
# LAKEHOUSE_SPARK_QUERY_MINUTES=30
# Write-conflict handling. When two replicas write the same rows, the losing
# commit applies NOTHING, so re-running the statement is exactly-once.
# Times a losing write statement is re-run on a fresh snapshot (default 3).
# LAKEHOUSE_WRITE_RETRIES=3
# DuckLake's own in-transaction commit retries (defaults 10 / 100ms).
# LAKEHOUSE_COMMIT_RETRIES=10
# LAKEHOUSE_COMMIT_RETRY_WAIT_MS=100
# Parquet metadata caching on the shared engine (on by default; measured ~20%
# faster across different queries over the same files). Safe because DuckLake
# never rewrites a data file. Set to false only to rule it out while debugging.
# LAKEHOUSE_METADATA_CACHE=true
# Per-file target when a table is rewritten in key order (Layout → Rewrite
# now); a table's own setting wins over this. Bytes, uncapped. Default 128 MiB.
# LAKEHOUSE_CLUSTER_FILE_BYTES=134217728

# ── Answer Passport signing ──────────────────────────────────────────────────
# Signs the provenance documents downloaded from a trace's Provenance section
# (HMAC-SHA256, 16+ chars). WITHOUT it passports are still produced and still
# complete -- they are simply unsigned, and say so in their own notes rather
# than looking signed.
PROVENANCE_SIGNING_SECRET=""

# ── Machine learning ──────────────────────────────────────────────────────────
# Training runs in a batch sandbox of the notebook runtime and reads its rows
# from the lakehouse. None of these is a ceiling written into the code: each is
# a default an operator overrides here or, without a redeploy, under
# Admin -> Developer runtime. Size them to the machine — a large VM is allowed
# to train on all of its rows.
ML_TRAIN_MAX_ROWS=""                    # 2000000 — rows read per run; bigger tables are reservoir-sampled
ML_TRAIN_TIME_BUDGET_MINUTES=""         # 30 — default wall-clock budget per run
ML_TRAIN_MEM_LIMIT_MB=""                # 8192 — memory ceiling of a training sandbox
ML_MAX_CONCURRENT_TRAININGS_PER_USER="" # 2
ML_PREDICT_MAX_ROWS=""                  # 5000000 — rows one batch prediction may score
ML_API_RATE_LIMIT_PER_MIN=""            # 60 — calls a minute one ML API key may make (/api/ml/*)
ML_TRAIN_WORKERS=""                     # 1 — sandboxes a training job spreads its algorithm search across
                                        #     (each trains its share of the candidates; the job keeps the best).
                                        #     Bounded by sessions-per-user (Admin -> Developer runtime);
                                        #     classification and regression only, and a single model still
                                        #     trains in one container.
ML_TRAIN_GPUS=""                        # 0 — GPUs requested per training sandbox (needs a CUDA runtime image)
ML_DRIFT_ALERT_PSI=""                   # 0.25 — PSI above which a batch prediction notifies the owner of drift
ML_ARTIFACT_MAX_MB=""                   # 512 — largest model a notebook run may save through the app
ML_MAX_DEPLOYMENTS_PER_USER=""          # 2 — warm inference endpoints one person may hold open (each holds a model in memory)
ML_MAX_DEPLOYMENTS_TOTAL=""             # 10 — warm inference endpoints this instance may hold open
# Memory ceiling of one scorer replica, the container a deployed model
# answers from, in MB. Separate from ML_TRAIN_MEM_LIMIT_MB: a scorer holds one
# fitted model (measured at 169 MB) rather than fitting one. On Kubernetes a
# namespace ResourceQuota counts it per copy, so it decides how many copies
# fit. A value saved under Admin -> Developer runtime wins over this.
# ML_SERVE_MEM_LIMIT_MB=2048
# How model selection scores candidates. With a holdout of at least this many
# rows, one split inside the training rows; with fewer, k-fold
# cross-validation, which costs k fits per candidate. Time-ordered data always
# uses time-series folds. Lower it to train faster on small data, raise it to
# cross-validate larger sets. Admin -> Developer runtime wins over this.
# ML_CV_MIN_HOLDOUT_ROWS=2000
# Fewest rows each worker of a split refit may get. A winning model whose
# table has more rows than ML_TRAIN_MAX_ROWS is refitted across up to
# ML_TRAIN_WORKERS containers, one hashed slice each, only when every slice
# gets at least this many; otherwise it is sampled down to ML_TRAIN_MAX_ROWS
# and fitted in one. Measured: 25,000 rows a worker cost about half a point of
# F1 against a single fit. Admin -> Developer runtime wins over this.
# ML_PARALLEL_MIN_ROWS=25000
# How much worse than its validation score a model may do against real
# outcomes before its owner is notified (audited as ml.decay.alert). A ratio,
# so 0.1 means ten per cent worse whether the metric should rise (f1_macro)
# or fall (rmse). Admin -> Developer runtime wins over this.
# ML_DECAY_ALERT_RATIO=0.1
# Selection-rate ratio, against the best-treated group, below which a
# fairness check says a model is worth a review. 0.8 is the four-fifths rule
# of the US EEOC guidelines: a rule of thumb, not a law. Raise it to hold
# models to more. Admin -> Developer runtime wins over this.
# ML_FAIRNESS_MIN_RATIO=0.8
# Environment only, no Admin field: prediction runs measured against real
# outcomes in one scheduler pass. Each batch run is re-measured once a day
# while under 30 days old; this bounds a pass, not a resource.
# ML_EVALUATIONS_PER_SWEEP=20
# Environment only. An explanation ("why this answer") costs one extra
# prediction per feature per row. The rows of one request that get one (the
# rest are scored without), and the features returned for each.
# ML_EXPLAIN_MAX_ROWS=20
# ML_EXPLAIN_TOP_K=8
# Environment only. Reason codes on a batch prediction: the most rows a batch
# asking for them may have (a larger one is refused before its sandbox
# starts, never half-written), the reasons written per row (two columns
# each), and the rows explained at a time, which bounds the sandbox's memory
# but not the time taken.
# ML_EXPLAIN_BATCH_MAX_ROWS=50000
# ML_EXPLAIN_BATCH_TOP_K=3
# ML_EXPLAIN_CHUNK_ROWS=2000
# Environment only. Autoscaling of a deployed model whose minimum and maximum
# copies differ. The requests a minute one copy is sized for: a copy is added
# as soon as the measured rate needs one. And the cooldown in seconds: a copy
# is removed only this long after the last change either way, and only once
# the quietest copy has been idle this long.
# ML_SERVE_TARGET_RPM_PER_REPLICA=120
# ML_SERVE_SCALE_COOLDOWN_SECONDS=180

# AI gateway (inbound): the OpenAI-compatible endpoint under /api/v1, keyed
# per user under Integrations -> LLM Gateway -> API access. Both are defaults
# an operator can also change under Admin -> Developer runtime.
AI_GATEWAY_RATE_LIMIT_PER_MIN=""        # 60 — calls a minute one gateway key may make (a key can set its own)
SCIM_RATE_LIMIT_PER_MIN=""              # 300 — requests a minute /api/scim/v2 accepts from the identity provider, all tokens together
AI_GATEWAY_FALLBACK_MODELS=""           # comma-separated provider/model entries tried when a call fails, after the key's own chain
AI_GATEWAY_METRICS_MAX_ROWS=""          # 10000 — rows one metrics API query (/api/v1/metrics/query) may return
AI_GATEWAY_CACHE_SIMILARITY=""          # 0.97 — similarity a cached question must reach to answer a new one (keys with the cache on)
AI_GATEWAY_CACHE_TTL_HOURS=""           # 24 — hours a cached gateway answer stays reusable
AI_GATEWAY_CACHE_MAX_TEMPERATURE=""     # 0.3 — above this temperature a turn is never cached or served from cache

# Data monitors (Data & BI -> Data monitors): standing checks on tables, run
# on the scheduler sweep. Both are also editable under Admin -> Developer runtime.
DATA_MONITORS_PER_SWEEP=""              # 20 — due monitors one sweep runs
DATA_MONITOR_ANOMALY_SIGMA=""           # 3 — standard deviations from the learned baseline beyond which a volume check alerts

# Sheets (Data & BI -> Sheets): spreadsheets whose large tables live in the
# lakehouse. Both are also editable under Admin -> Developer runtime.
SHEETS_MAX_CELLS=""                     # 200000 — non-empty cells one grid sheet may hold
SHEETS_PAGE_ROWS=""                     # 500 — rows a table sheet fetches from the lakehouse per page
SHEETS_UPLOAD_MAX_MB=""                 # 50 — largest CSV a Sheets upload brings into the lakehouse
SHEETS_IMPORT_MAX_SHEETS=""             # 100 — most sheets one Excel/CSV import brings into a workbook
SHEETS_EXPORT_MAX_ROWS=""               # 100000 — most rows of a table sheet in a downloaded .xlsx/.csv
SHEETS_VERSION_INTERVAL_MINUTES=""      # 30 — minutes between automatic versions of a Sheets workbook
SHEETS_VERSIONS_MAX=""                  # 50 — automatic versions kept per Sheets workbook
# The Sheets assistant's model is set under Admin -> Developer runtime (empty = the default model).
SHEETS_ASSIST_PER_MINUTE=""             # 30 — Sheets assistant model calls per person a minute
SHEETS_AI_FILL_MAX_ROWS=""              # 2000 — most rows one Sheets Fill with AI works through

# Enterprise Ontology (Data & BI -> Enterprise Ontology): business objects,
# links, metrics, rules and actions over lakehouse tables. A row in
# notebook_runtime_settings (ontology_max_rows, ontology_max_spec_kb) wins.
ONTOLOGY_MAX_ROWS=""                    # 5000 — most rows one ontology query returns
ONTOLOGY_MAX_SPEC_KB=""                 # 4096 — largest ontology document saved, in KB

# AI in SQL (Lakehouse): ai_complete / ai_classify / ai_extract / ai_sentiment /
# ai_summarize / ai_translate / ai_filter as scalar functions. Every call goes
# through the model channel (IAM model rules, budget, trace, cost); answers are
# cached per user and model. Both are also editable under Admin -> Developer runtime.
AI_SQL_MAX_CALLS_PER_STATEMENT=""       # 200 — model calls one statement may make (distinct inputs; cached answers are free)
# The model ai_* functions use when the statement names none is set under Admin -> Developer runtime (empty = the default model).
AI_SQL_CACHE_TTL_DAYS=""                # 30 — days an answer is reused before the model is asked again

# Document intelligence (Knowledge Base uploads): a scanned PDF or an image is
# read page by page with a vision-capable model, each page one governed call.
# The vision model is set under Admin -> Developer runtime (empty = the default
# model; it must accept images). The page limit is also editable there.
DOCUMENT_VISION_MAX_PAGES=""            # 200 — pages one uploaded document may have read
# Kubernetes only: where GPU training pods may run (JSON), when ML_TRAIN_GPUS > 0 and the pool is labelled or tainted.
NOTEBOOK_K8S_GPU_NODE_SELECTOR=""       # e.g. {"cloud.google.com/gke-accelerator":"nvidia-l4"}
NOTEBOOK_K8S_GPU_TOLERATIONS=""         # e.g. [{"key":"nvidia.com/gpu","operator":"Exists","effect":"NoSchedule"}]
