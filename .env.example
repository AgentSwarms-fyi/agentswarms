# Supabase connection (required)
# Find these under your Supabase project → Settings → API.
SUPABASE_PROJECT_ID=""
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Same three values again, but VITE_-prefixed so Vite exposes them to
# browser-side code. Vite only inlines env vars that start with VITE_ into
# the client bundle — the two sets of vars are read by different halves of
# the app (server routes/functions vs. the React client), so both are
# required even though the values are identical.
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Default LLM provider (OpenRouter) — optional, but without it every user
# must connect their own provider key under /integrations before any agent,
# swarm, or notebook can call an LLM. When set, it's used as the app-wide
# zero-config default; a user's own saved OpenRouter/other provider key
# always takes precedence over this one. No per-user usage caps are applied
# — you own the key and the budget. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=""
# Optional: default model id for requests that don't specify one.
OPENROUTER_DEFAULT_MODEL="openai/gpt-4o-mini"
# Optional: override if you're routing OpenRouter through a proxy/gateway.
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Optional: enables Knowledge Base embeddings (vector search / RAG). OpenRouter
# has no embeddings endpoint, so this is a separate key called directly
# against OpenAI's API. Without it, KB documents fall back to keyword search.
OPENAI_API_KEY=""

# Admin email — the account allowed to access the instance admin dashboard.
VITE_ADMIN_EMAIL=""
ADMIN_EMAIL=""

# ── Outbound email (all optional) ────────────────────────────────────────────
# Transactional emails (welcome, budget alerts, certificates) are best-effort:
# with none of these set, sends are skipped and logged — the app works fine.
# Auth emails (confirmation, password reset) are sent by Supabase itself and
# are configured in your Supabase dashboard, not here.
#
# Option A — Resend (https://resend.com; works on Node AND Cloudflare Workers):
RESEND_API_KEY=""
# Option B — any SMTP server (Node/Docker deployments only):
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
# From address used for all outbound mail, e.g. 'AgentSwarms <noreply@your-domain.com>'
EMAIL_FROM=""
# Public URL of this instance — used for links inside emails.
SITE_URL="http://localhost:8080"