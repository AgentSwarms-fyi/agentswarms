# Supabase connection (required)
# Find these under your Supabase project → Settings → API.
SUPABASE_PROJECT_ID=""
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Same three values again, but VITE_-prefixed so Vite exposes them to
# browser-side code. Vite only inlines env vars that start with VITE_ into
# the client bundle — the two sets of vars are read by different halves of
# the app (server routes/functions vs. the React client), so both are
# required even though the values are identical.
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Default LLM provider (OpenRouter) — optional, but without it every user
# must connect their own provider key under /integrations before any agent,
# swarm, or notebook can call an LLM. When set, it's used as the app-wide
# zero-config default; a user's own saved OpenRouter/other provider key
# always takes precedence over this one. No per-user usage caps are applied
# — you own the key and the budget. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=""
# Optional: default model id for requests that don't specify one.
OPENROUTER_DEFAULT_MODEL="openai/gpt-4o-mini"
# Optional: override if you're routing OpenRouter through a proxy/gateway.
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Optional: enables Knowledge Base embeddings (vector search / RAG). OpenRouter
# has no embeddings endpoint, so this is a separate key called directly
# against OpenAI's API. Without it, KB documents fall back to keyword search.
OPENAI_API_KEY=""

# Admin email — the account allowed to access the instance admin dashboard.
VITE_ADMIN_EMAIL=""
ADMIN_EMAIL=""

# Encryption key for stored credentials (warehouse connections, Secrets
# Manager, Data Catalog bucket keys). Any long random string works — e.g.
#   openssl rand -hex 32
# Required for those features; rotating it invalidates already-saved
# credentials (users just re-enter them).
PROVIDER_CREDS_SECRET=""

# ── Outbound email (all optional) ────────────────────────────────────────────
# Transactional emails (welcome, budget alerts, certificates) are best-effort:
# with none of these set, sends are skipped and logged — the app works fine.
# Auth emails (confirmation, password reset) are sent by Supabase itself and
# are configured in your Supabase dashboard, not here.
#
# Option A — Resend (https://resend.com; works on Node AND Cloudflare Workers):
RESEND_API_KEY=""
# Option B — any SMTP server (Node/Docker deployments only):
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
# From address used for all outbound mail, e.g. 'AgentSwarms <noreply@your-domain.com>'
EMAIL_FROM=""
# Public URL of this instance — used for links inside emails.
SITE_URL="http://localhost:8080"

# ── Developer workspace: server-side Python runtime (all optional) ────────────
# OFF by default. The workspace runs notebooks in the browser (Pyodide) with no
# setup. To let notebooks pip-install and run the REAL frameworks (LangChain,
# LlamaIndex, LangGraph), enable the containerized server runtime and bring up
# docker-compose.notebooks.yml (or the K8s manifests). Full guide + security
# model: docs/DEVELOPER_WORKSPACE_RUNTIME.md.
#
# Master switch (also toggleable per-instance in the DB settings row):
NOTEBOOK_RUNTIME_ENABLED=""
# Signs the short-lived, session-scoped tokens kernels use to call back for
# governed model/KB access. REQUIRED to use the server runtime. Min 16 chars:
#   openssl rand -hex 32
NOTEBOOK_RUNTIME_SECRET=""
# Backend: docker (single host) | k8s (cluster) | e2b (managed microVMs).
NOTEBOOK_RUNTIME_BACKEND="docker"
# Kernel image the orchestrator launches (build it from docker/notebook-runtime).
NOTEBOOK_RUNTIME_IMAGE="agentswarms/notebook-runtime:latest"
# Public websocket URL of the runtime gateway (browsers connect here).
NOTEBOOK_GATEWAY_URL="ws://localhost:8090"
# Token for the reaper cron endpoint (/api/notebook/runtime/reap). Falls back to
# BI_CRON_TOKEN if unset.
NOTEBOOK_CRON_TOKEN=""
#
# Docker backend wiring (set by docker-compose.notebooks.yml; override if needed):
#   DOCKER_PROXY_URL         URL of the least-privilege Docker socket-proxy
#   NOTEBOOK_NETWORK         internal Docker network kernels attach to
#   NOTEBOOK_EGRESS_PROXY    forward proxy kernels must use for egress
#   NOTEBOOK_APP_INTERNAL_URL in-cluster URL kernels call back to (this app)
#
# Kubernetes backend wiring (set on the app deployment):
#   NOTEBOOK_K8S_NAMESPACE   namespace for kernel pods/jobs (default agentswarms-notebooks)
#   NOTEBOOK_K8S_RUNTIME_CLASS  optional RuntimeClass, e.g. "gvisor"
#   NODE_EXTRA_CA_CERTS      path to the cluster CA so the app trusts the API server