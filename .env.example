# =============================================================================
#  AgentSwarms configuration
# =============================================================================
#  Three tiers, in order:
#
#    1. REQUIRED     — the app will not run correctly without these.
#    2. RECOMMENDED  — it runs, but a core capability is missing or degraded.
#    3. OPTIONAL     — everything else. Sensible defaults; skip the lot.
#
#  Only section 1 is needed for a first run. Full walkthrough: docs/INSTALL.md
#  Every row/timeout/concurrency cap and what it bounds: docs/SCALE_AND_LIMITS.md
# =============================================================================


# =============================================================================
#  1. REQUIRED
# =============================================================================

# ── Supabase: your database, auth and file storage ───────────────────────────
# Supabase Cloud: Project → Settings → API.
# Self-hosted Supabase (full data residency / air-gap): see
# docs/DEPLOYMENT.md § "Self-hosted Supabase".
#
# NOTE: the Supabase *Project ID* is deliberately NOT here. Nothing at runtime
# reads it — the CLI takes it as a flag: `supabase link --project-ref <id>`.
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# The same URL and PUBLISHABLE key again, VITE_-prefixed. Vite only inlines
# vars starting with VITE_ into the browser bundle, and the two halves of the
# app (server routes/functions vs. the React client) each need their own copy.
#
# NEVER put the service-role key behind a VITE_ prefix — that ships a
# database-bypassing secret to every visitor's browser.
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# ── Operator account ─────────────────────────────────────────────────────────
# The email allowed into the instance admin dashboard. BOTH must be set and
# they must MATCH — the server enforces access, the client decides what to
# render. Use the address you will sign up with.
ADMIN_EMAIL=""
VITE_ADMIN_EMAIL=""

# ── Encryption key for stored credentials ────────────────────────────────────
# Encrypts every credential at rest: LLM provider and gateway keys, n8n tokens,
# MCP bearer tokens, warehouse connections, Secrets Manager, Data Catalog
# bucket keys. Generate once:
#
#   openssl rand -hex 32
#
# Required before anyone connects a provider or a warehouse. Rotating it does
# not re-encrypt anything — saved credentials become unreadable and must be
# re-entered. Back it up separately from your database: a database backup
# without this key cannot restore credentials.
PROVIDER_CREDS_SECRET=""


# =============================================================================
#  2. RECOMMENDED
# =============================================================================

# ── Default LLM provider (OpenRouter) ────────────────────────────────────────
# Without it the app still runs, but every user must connect their own provider
# key under /integrations before any agent, swarm or notebook can call a model.
# When set it is the app-wide zero-config default; a user's own saved key always
# takes precedence. No per-user caps are applied — you own the key and the bill.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=""
# Default model id for requests that don't specify one.
OPENROUTER_DEFAULT_MODEL="openai/gpt-4o-mini"
# Override if you route OpenRouter through a proxy/gateway.
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# ── Knowledge Base embeddings ────────────────────────────────────────────────
# Enables real vector search (RAG). OpenRouter has no embeddings endpoint, so
# this is a separate key called directly against OpenAI. WITHOUT it, Knowledge
# Base documents fall back to keyword search — noticeably worse retrieval.
OPENAI_API_KEY=""

# ── Public URL ───────────────────────────────────────────────────────────────
# Used in outbound email links and as the default origin for scheduled work.
# Change it to your real https:// origin in production, or emailed links point
# at localhost.
SITE_URL="http://localhost:8080"


# =============================================================================
#  3. OPTIONAL
# =============================================================================

# ── Agent web tools (search + browse) ────────────────────────────────────────
# Powers web_search + web_browse workspace-wide. Get a key at
# https://firecrawl.dev
#   • WITHOUT a key, web_search still runs but falls back to DuckDuckGo's free
#     Instant Answer API — entity summaries only, so results are thin/empty for
#     ordinary queries.
#   • web_browse (fetch a page as clean markdown) REQUIRES a key and is hidden
#     from agents until one exists.
# You do NOT have to set this here — two UI alternatives exist:
#   • Connect Firecrawl on the Integrations page (encrypted, no restart).
#   • Give one agent its own key in the agent editor's web tools
#     (Brave / SerpAPI / Tavily for search; ScrapingBee or custom Firecrawl).
# Resolution order: per-agent key → this var → the Integrations connector.
FIRECRAWL_API_KEY=""

# ── Web analytics for YOUR deployment (both default to off) ──────────────────
# When set, public pages show a consent banner and load Google Analytics / Tag
# Manager with YOUR ids after the visitor accepts. Left unset, no banner is
# shown and no analytics request is ever made — which is what the "no
# telemetry" statement on /architecture and /security describes.
VITE_GA_ID=""
VITE_GTM_ID=""

# ── JS sandbox for headless custom code ──────────────────────────────────────
# Function nodes and custom components run user-authored JavaScript. On the
# canvas that runs in the browser; for DEPLOYED (API-key) and SCHEDULED runs it
# runs in a separate hardened container so it never shares a process with your
# service-role key.
#
#   docker compose --profile sandbox up -d --build
#
# Inside Compose the app already defaults to http://js-sandbox:8091, so leave
# this empty. Set it only when the app runs on the HOST (npm run dev), where the
# service is published on loopback:
#   JS_SANDBOX_URL="http://127.0.0.1:8091"
#
# Unset = custom code stays canvas-only, and deployed runs say so rather than
# failing mysteriously. Details: docs/DEPLOYMENT.md § "JS sandbox".
JS_SANDBOX_URL=""
# Ceilings enforced BY the sandbox (a caller cannot raise them).
JS_SANDBOX_MAX_TIMEOUT_MS="5000"
JS_SANDBOX_MAX_CONCURRENT="4"
JS_SANDBOX_MEM_MB="128"
# Largest /run request the sandbox accepts (code + context), in bytes.
JS_SANDBOX_MAX_BODY_BYTES="1000000"

# ── BI widget snapshot size ──────────────────────────────────────────────────
# Rows kept in a BI widget's cached snapshot (default 500, ceiling 100000).
# The snapshot is what shared links, public embeds and offline views render,
# and it lives inside the dashboard row — so raising it trades storage and
# dashboard load time for how much raw data a browser-side sum can see. An
# aggregated widget (agg_pushdown) needs far less than 500; a widget summing
# RAW rows is capped here and reports `truncated` when it hits it.
# VITE_-prefixed, so it is baked at BUILD time: `docker compose` passes it
# through automatically, but changing it means rebuilding the image rather
# than restarting it. Details: docs/SCALE_AND_LIMITS.md
VITE_BI_SNAPSHOT_ROWS_CAP=""

# ── Outbound email (all optional) ────────────────────────────────────────────
# Transactional emails (welcome, budget alerts, certificates) are best-effort:
# with none of these set, sends are skipped and logged — the app works fine.
# Auth emails (confirmation, password reset) are sent by Supabase itself and
# are configured in your Supabase dashboard, not here.
#
# Option A — Resend (https://resend.com; a hosted HTTP API, no SMTP server).
# The key alone is NOT enough: add your domain in Resend, publish the SPF/DKIM
# DNS records it gives you, verify it, then set EMAIL_FROM to an address on that
# domain. Until a domain is verified Resend sends only from onboarding@resend.dev
# and delivers only to the account owner's own address — fine for a smoke test,
# useless for real users. See docs/INSTALL.md.
RESEND_API_KEY=""
# Option B — any SMTP server (Node/Docker deployments only):
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
# From address for all outbound mail: 'AgentSwarms <noreply@your-domain.com>'.
# MUST be on a domain verified with your provider. Left empty it falls back to
# noreply@example.com, which Resend rejects — every app email then fails while
# the app looks healthy. Check the email_send_log table if mail stops arriving.
EMAIL_FROM=""
# (SITE_URL is declared once, in section 2 — email links use it too.)

# ── Internal self-calls (deployed swarms + scheduled runs) ───────────────────
# Headless swarm runs execute their LLM nodes by calling this app's OWN
# /api/chat over HTTP, authenticated with an internal shared secret.
#
# The origin for those self-calls is resolved ONLY from configuration —
# PUBLIC_APP_URL, then SITE_URL, then http://127.0.0.1:$PORT. It is never taken
# from the incoming request's Host header, which a caller controls and which
# would otherwise leak the secret below to an attacker's server.
#
# Leave PUBLIC_APP_URL empty for normal single-container/VM deploys (the
# loopback fallback works). Set it when the app can't reach itself on localhost
# from inside its own container (e.g. some PaaS / split ingress setups).
PUBLIC_APP_URL=""

# Shared secret for those internal self-calls. STRONGLY RECOMMENDED: set this to
# any long random string. If unset, the service-role key is used as the secret,
# which needlessly puts your database master key into outbound HTTP headers.
INTERNAL_RUN_SECRET=""

# ── Deployed-swarm limits (POST /api/swarm/run) ──────────────────────────────
# A swarm run can make many model calls and hold a worker for minutes, so each
# API key is bounded. Counters are per app instance: behind a load balancer with
# N instances the effective ceiling is N x these values (enforce a hard global
# limit at your ingress/CDN if you need one).
#
# Requests per minute per API key (default 30).
SWARM_RUN_RATE_LIMIT_PER_MIN=""
# Simultaneous in-flight runs per API key (default 5).
SWARM_RUN_MAX_CONCURRENT=""
# Whole-run wall-clock budget in ms, shared by nested Execute-Swarm nodes
# (default 600000 = 10 minutes). Raise it for long foreach/loop swarms.
SWARM_RUN_TIMEOUT_MS=""

# ── Outbound fetch safety (HTTP nodes, web_browse, provider tests, MCP) ───────
# Everything that fetches a URL chosen by a user or the MODEL from inside your
# network goes through one guard: swarm HTTP nodes, the web_browse tool, the
# "Test connection" button on the Integrations page (Ollama / vLLM / n8n and any
# custom base_url), the n8n webhook, and MCP server probe/tool calls.
#
# Cloud instance metadata and link-local addresses (169.254.169.254 and the rest
# of 169.254.0.0/16, IPv6 link-local) are ALWAYS refused — they can hand out the
# host's IAM credentials and nothing legitimately fetches them. Ordinary private
# networks (localhost, RFC1918, in-cluster) are ALLOWED BY DEFAULT, because
# self-hosted model servers, MCP servers and n8n live there. Every redirect hop
# is re-validated so a public URL can't 302 into a blocked range.
#
# Set BLOCK_PRIVATE_NETWORK_FETCH=true to ALSO refuse ordinary private/internal
# targets — recommended for untrusted multi-tenant installs or public embeds,
# where web_browse is model-driven and could be steered at your internal network.
# (metadata stays blocked either way.)
BLOCK_PRIVATE_NETWORK_FETCH=""
# Legacy: forces the permissive behaviour even if BLOCK_… is set. You normally
# don't need this now that private networks are allowed by default.
ALLOW_PRIVATE_NETWORK_FETCH=""

# ── Audit trail ──────────────────────────────────────────────────────────────
# Retention is set per-instance in the DB (iam_settings.audit_retention_days,
# default 365). Before deleting expired rows the purge writes them to stdout as
# NDJSON lines prefixed `audit-archive`, so any log shipper keeps a copy after
# the database copy is gone.
#
# Set to 0/false to skip that — e.g. if you already pull the trail via
# GET /api/audit/export (NDJSON, superadmin bearer token, ?stream=audit|traces|runs
# with optional &since=&until=), which is the better route for SIEM ingestion.
AUDIT_ARCHIVE_ON_PURGE=""

# ── Prometheus / OpenMetrics scrape endpoint ─────────────────────────────────
# GET /api/metrics exposes fleet-level operational gauges (run/trace volume,
# error mix, month-to-date spend, active users) in the Prometheus text
# exposition format, for Prometheus / Grafana Agent / the Datadog OpenMetrics
# check. It aggregates ALL tenants, so it is DISABLED unless you set a token:
# leave this empty and the endpoint returns 404. When set, scrapers must send
# `Authorization: Bearer <this>`. Generate one with e.g. `openssl rand -hex 32`.
# The payload is cached ~15s per instance, so scrape as often as you like.
METRICS_TOKEN=""

# ── OpenTelemetry trace export (OTLP/HTTP) ───────────────────────────────────
# Stream multi-agent runs and LLM calls to any OTLP collector — the Datadog
# Agent's OTLP receiver, Grafana Tempo, Jaeger, or otelcol — as distributed
# traces. DISABLED unless an endpoint is set. A background job on the scheduler
# pass reads newly-finished swarm runs (root span + a child span per node, so
# you get the full waterfall) and execution traces (one span per LLM call, with
# OpenTelemetry GenAI `gen_ai.*` attributes) and POSTs them. It's fully
# decoupled from the request path, so it can never slow or break a live call,
# and only span METADATA is sent (model, tokens, cost, status, timing, node
# graph) — never prompt/response text — so it carries no user content.
#
# Base collector endpoint; the exporter appends /v1/traces. e.g. an in-cluster
# collector: http://otel-collector:4318  (or the Datadog Agent: http://datadog-agent:4318)
OTEL_EXPORTER_OTLP_ENDPOINT=""
# Optional: full traces URL instead of the base above (takes precedence).
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=""
# Optional: extra headers as comma-separated key=value pairs — e.g. an API key
# for a hosted collector: "dd-api-key=xxxxx" or "authorization=Bearer xxxxx".
OTEL_EXPORTER_OTLP_HEADERS=""
# Optional: service.name on the exported resource (default "agentswarms").
OTEL_SERVICE_NAME=""

# Persist prompt/response bodies in traces (default true). Set to false for
# regulated tenants that cannot keep user content at rest: traces and swarm-run
# steps then store the full operational skeleton — model, provider, tokens,
# cost, latency, status, node graph, tool-call shape — but drop the prompt,
# response, node input/output and chain-of-thought text. Applies at write time
# only (not retroactive); pair with trace_retention_days for older rows.
PERSIST_PROMPT_BODIES=""

# ── Local SQL engine (uploaded datasets, prep flows, BI, semantic models) ────
# SQL over LOCAL datasets — everything you upload, plus prep flows, BI widgets,
# semantic models and the agents' sql_query tool — runs in-process. You need
# NONE of this to run the app.
#
# Leave EMPTY. The default is DuckDB, a columnar engine with real SQL: CTEs,
# window functions, subqueries and proper JOINs.
#
# Set to `alasql` ONLY as an escape hatch, if the native module will not install
# on your platform. AlaSQL is a JS interpreter with no window functions, no
# CTEs and no subqueries, so the semantic layer's period-over-period comparisons
# do not work on it. Any other value is treated as the default, so a typo cannot
# silently downgrade your engine.
#
# Behaviour differences are small but real and are written down rather than
# discovered — see docs/TESTING.md. The two notable ones: DuckDB sorts NULLs
# last in both directions, and it rejects backtick-quoted identifiers.
LOCAL_ENGINE=""
# Per-query ceilings for DuckDB, shown with their defaults. Ignored when you
# have opted out with LOCAL_ENGINE=alasql; leave blank to keep the default.
LOCAL_ENGINE_MEMORY_MB=""     # 512
LOCAL_ENGINE_THREADS=""       # 2
LOCAL_ENGINE_TIMEOUT_MS=""    # 30000
#
# Columnar mirror: DuckDB can read a dataset from a cached Parquet copy instead
# of its rows, which makes a large dataset's repeat queries much faster (8 ms
# against 20 ms on 5,000 rows, and the gap widens with size). On by default;
# set to 0 to disable. The mirror is a strict cache — it is used only while it
# is newer than the data, and NEVER for a SHARED dataset, because a mirror
# holds unmasked rows and a stale one would serve a revoked grantee. Shared
# datasets always read their rows directly, which is correct and fast enough.
PARQUET_MIRROR=""
# Smallest dataset worth mirroring, and the cache's disk budget.
PARQUET_MIN_ROWS=""           # 5000
PARQUET_CACHE_MAX_BYTES=""    # 2 GiB
# Defaults to a subdirectory of the system temp dir. Set this to keep the cache
# on a specific volume, or to survive restarts on a host with a volatile /tmp.
PARQUET_CACHE_DIR=""

# ── External data connections (warehouses + app sources) ─────────────────────
# NONE of this is required. The defaults are the recommended settings; these
# exist for tuning against a specific warehouse or network. Full explanations,
# including how the numbers were measured, are in docs/DEPLOYMENT.md.

# Per-query ceilings and concurrency for every warehouse query the app makes.
WAREHOUSE_MAX_ROWS=""                 # 1000  — default rows returned
WAREHOUSE_ABS_MAX_ROWS=""             # 5000  — hard ceiling, no caller exceeds
WAREHOUSE_QUERY_TIMEOUT_MS=""         # 60000
WAREHOUSE_MAX_CONCURRENT=""           # 8     — in flight per instance
WAREHOUSE_MAX_CONCURRENT_PER_USER=""  # 3
WAREHOUSE_QUEUE_TIMEOUT_MS=""         # 30000 — wait for a slot before failing

# Connection pooling for PostgreSQL/MySQL-family connections. Measured on a
# local Postgres, opening a connection was 92% of a SELECT 1 (24.9ms of
# 27.1ms); pooling took the driver from 30.7ms to 2.9ms per query. Reproduce
# with `npx vite-node scripts/bench-pool.ts`. Set WAREHOUSE_POOL=off to go
# back to a connection per query.
#
# SIZING: sockets held ≈ WAREHOUSE_POOL_MAX x WAREHOUSE_POOL_MAX_KEYS x
# replicas. Check that against your database's max_connections.
WAREHOUSE_POOL=""                     # on
WAREHOUSE_POOL_MAX=""                 # 4     — sockets per credential set
WAREHOUSE_POOL_IDLE_MS=""             # 30000 — before an idle socket closes
WAREHOUSE_POOL_TTL_MS=""              # 300000 — before a whole pool is dropped
WAREHOUSE_POOL_MAX_KEYS=""            # 64    — distinct credential sets held

# Outbound HTTP for warehouse APIs and app sources (Stripe, Sheets, CRMs).
#
# PROXY: if your network has no direct egress, set these and the connectors
# will use them. Without it the product cannot reach Snowflake or Stripe from
# inside such a network, and it looks like a timeout rather than a setting.
# NO_PROXY takes a comma-separated bypass list: `*` bypasses everything,
# `internal.corp` matches that host and its subdomains, `db.corp:5432` only
# that port. Lower-case spellings are accepted too.
HTTPS_PROXY=""
HTTP_PROXY=""
NO_PROXY=""

# RETRIES on transient failures (408/429/502/503/504 and transport errors),
# with exponential backoff, full jitter, and Retry-After honoured when sent.
CONNECTOR_MAX_RETRIES=""              # 2 (max 5; 0 disables)
CONNECTOR_RETRY_BASE_MS=""            # 400
CONNECTOR_RETRY_MAX_MS=""             # 8000 — caps any single wait
# 500 is NOT retried by default: it usually means the query reached the
# backend and failed there, so a retry pays for the same scan twice. Turn on
# for a provider that returns 500 for throttling.
CONNECTOR_RETRY_500=""                # off

# Scheduled re-validation of connection credentials, using the product's own
# probes (a SELECT 1 through the real driver; the same stream listing the
# "test" button makes). Advisory only — nothing is auto-disabled, and a
# failure notifies once per transition rather than every pass.
CONNECTION_HEALTH_HOURS=""            # 12 (0 disables)
# Age at which a credential is badged as old in the Integrations UI. Measured
# from when the secret was last entered, so re-saving resets it and a health
# check does not. Nothing expires.
CREDENTIAL_MAX_AGE_DAYS=""            # 90

# ── Budget enforcement ───────────────────────────────────────────────────────
# /budgets stores a monthly_cap_usd per user, but by default it only drives
# threshold ALERT emails — spend is never actually blocked.
#
# Set to true to make the cap a hard stop: once month-to-date spend reaches it,
# model calls return 402 until the next month or the cap is raised. Off by
# default because monthly_cap_usd defaults to a very small value, so enabling
# it on an existing instance whose caps were never meant to bite would start
# refusing calls immediately. Review your caps, then turn this on.
ENFORCE_BUDGET_CAP=""

# ── Scheduling & horizontal scaling ──────────────────────────────────────────
# AgentSwarms runs a lightweight in-process scheduler on a 60s tick: BI
# refreshes, data alerts, scheduled reports, swarm schedules, catalog crawls,
# and notebook-kernel reaping. On a SINGLE instance you need nothing here.
#
# Token so an EXTERNAL scheduler can drive the same work by POSTing to
# /api/bi/cron with `Authorization: Bearer <this>`. Recommended once you run
# more than one instance.
BI_CRON_TOKEN=""
# Set to 1 on every replica of an AUTOSCALED / multi-instance deployment so the
# web tier does NOT run its own in-process scheduler — instead point ONE
# external cron at /api/bi/cron every minute (see docs/DEPLOYMENT.md). A
# cross-instance lease already prevents double-firing, so this is optional
# hygiene, not correctness. Leave empty for single-instance and local runs.
DISABLE_INPROCESS_SCHEDULER=""

# ── Server-side PowerPoint renderer (optional, Node/Docker only) ──────────────
# By default, PPT/Word/Excel are generated IN THE BROWSER (pptxgenjs) — works on
# every deploy, nothing to configure. Optionally run the `docgen` container (python-pptx → NATIVE editable charts/tables + a LibreOffice
# render-verify loop) and point the app at it:
#
#   docker compose --profile docgen up -d --build
#
# You can leave this EMPTY: the app probes http://docgen:8099 (compose network)
# and http://localhost:8099 (published loopback port) and uses whichever answers,
# so both of these work without configuration:
#
#   Docker stack (app in a container)  →  reached as http://docgen:8099
#   Local dev server (npm run dev)     →  reached as http://localhost:8099
#
# Set it only when the renderer runs somewhere else (another host, another port).
# A value that doesn't answer is not fatal — the probe falls back to the two
# names above, so a stale setting can't silently disable Deep mode.
#
# "Deep" mode uses the service and falls back to the in-browser generator if it
# is unreachable — which produces a file IDENTICAL to "Browser · fast". The
# composer greys out Deep and says why when it can't be reached
# (GET /api/docgen/status).
DOCGEN_SERVICE_URL=""
# Optional shared bearer token between the app and the docgen container (set the
# same value on both). Leave empty for a private in-network service.
DOCGEN_TOKEN=""

# ── Developer workspace: server-side Python runtime ───────────────────────────
# NOTHING HERE IS REQUIRED unless you want the Developer-workspace server
# runtime — real server kernels that pip install and run LangChain / LlamaIndex
# / LangGraph. Enable it with:
#
#   docker compose --profile notebooks up -d --build
#
# then enable it under Admin → Developer runtime. The app generates its own
# signing secret and defaults every internal URL to the compose service names.
# Security model + scaling: docs/DEVELOPER_WORKSPACE_RUNTIME.md.
#
# The settings below are OPTIONAL overrides for non-standard deployments.
#
# Force-enable without using the admin UI (the DB setting is the normal switch):
NOTEBOOK_RUNTIME_ENABLED=""
# Manage the token-signing secret yourself instead of letting the app generate
# one (min 16 chars). Only needed if you run replicas that don't share a DB.
NOTEBOOK_RUNTIME_SECRET=""
# Backend: docker (single host) | k8s (app must run IN-cluster) | e2b (stub).
NOTEBOOK_RUNTIME_BACKEND="docker"
NOTEBOOK_RUNTIME_IMAGE="agentswarms/notebook-runtime:latest"
# Public websocket URL browsers use to reach the gateway. Change this if the
# gateway isn't on localhost:8090 (e.g. behind a domain: wss://nb.example.com).
NOTEBOOK_GATEWAY_URL="ws://localhost:8090"
# Token for the reaper cron endpoint (/api/notebook/runtime/reap). Falls back to
# BI_CRON_TOKEN if unset.
NOTEBOOK_CRON_TOKEN=""
#
# Docker wiring — defaults already match the compose service names:
#   DOCKER_PROXY_URL          default http://notebook-docker-proxy:2375
#   NOTEBOOK_EGRESS_PROXY     default http://notebook-egress:3128
#   NOTEBOOK_NETWORK          default agentswarms_nb-internal
#   NOTEBOOK_APP_INTERNAL_URL default http://agentswarms:8080 — the URL a
#                             kernel calls back on. Falls back to APP_URL, then
#                             to the compose service name or the Docker host
#                             gateway depending on where the app is running.
#   APP_URL                   that fallback. Distinct from PUBLIC_APP_URL: this
#                             is an INTERNAL address a container uses, not the
#                             public one that goes in emails.
#   NOTEBOOK_DOCKER_HOST      default unix:///var/run/docker.sock — used only to
#                             apply the egress allowlist to the proxy container
#   NOTEBOOK_EGRESS_CONTAINER default notebook-egress — which container that is
#   NOTEBOOK_RUN_USER         default 1000:1000 — uid:gid kernels run as
#
# Kubernetes wiring (set on the app deployment; the app must run in-cluster):
#   NOTEBOOK_K8S_NAMESPACE      default agentswarms-notebooks
#   NOTEBOOK_K8S_RUNTIME_CLASS  optional RuntimeClass, e.g. "gvisor"
#   NOTEBOOK_K8S_PULL_POLICY    default IfNotPresent
#   NODE_EXTRA_CA_CERTS         path to the cluster CA so the app trusts the API server
#
# Browser-facing websocket port for the gateway. Change only if the gateway
# is not on :8090 — NOTEBOOK_GATEWAY_URL overrides this entirely.
VITE_NOTEBOOK_GATEWAY_PORT=""   # 8090
# Cell wall-clock limit enforced BY THE GATEWAY (services/notebook-gateway).
# The admin UI's cell_timeout_seconds is a separate value read by the app —
# change one and the gateway keeps using its own until you set this too.
NOTEBOOK_CELL_TIMEOUT_SECONDS=""  # 120

# ── Rate limits and concurrency ──────────────────────────────────────────────
# All per app instance: behind a load balancer with N instances the effective
# ceiling is N x these. Enforce a hard global limit at your ingress if needed.
BI_DIRECT_QUERY_RATE_PER_MIN=""    # 120 — live warehouse queries, per dashboard OWNER
                                   #       (so many viewers of one shared dashboard
                                   #       cannot hammer the owner's warehouse)
MCP_RATE_LIMIT_PER_MIN=""          # 120 — requests per MCP API key
MCP_MAX_CONCURRENT_PER_SERVER=""   # 8   — in-flight calls per published MCP server

# How many reverse proxies of YOURS sit in front of the app. Used to find the
# real caller address in X-Forwarded-For, which an MCP key's IP allow-list is
# checked against. XFF is APPENDED to, so the entries your own proxies added are
# the only ones a caller cannot forge — this says how many to count back.
#   1  a single reverse proxy (the setup in docs/DEPLOYMENT.md) — default
#   2  a CDN in front of that proxy
# Too low reads your proxy's address instead of the caller's; too high reads a
# value the caller supplied, so it is clamped to the chain length.
TRUSTED_PROXY_HOPS=""              # 1

# What to do when the month-to-date SPEND LOOKUP fails, as opposed to coming
# back under cap. Default (unset) allows the call: governance should not be the
# reason legitimate work breaks. Set true when the cap must hold even if the
# figure cannot be established — the failure is logged either way.
BUDGET_FAIL_CLOSED=""              # false
UPLOAD_PER_MINUTE=""               # 10  — dataset uploads per user
INTEGRATION_TEST_PER_MINUTE=""     # 10  — "Test connection" presses per user
SWARM_LEVEL_CONCURRENCY=""         # 4   — nodes run in parallel per graph level

# ── Contact form and GitHub ingestion ────────────────────────────────────────
# Where the marketing-site contact form sends its admin notification. Never
# exposed to the client. Without it the message is still stored, just not
# emailed.
CONTACT_ADMIN_EMAIL=""
# Raises the Knowledge Base GitHub importer's rate limit. Public repos work
# with no token at 60 requests/hour; a token lifts that to 5000 and allows
# private repos it can read.
GITHUB_TOKEN=""