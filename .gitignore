# dependencies
/node_modules

# env
.env
.env.local
.env.*.local

# build output
/dist
/.output
/.vinxi
/.wrangler
/.tanstack
src/routeTree.gen.ts

# supabase CLI local state
/supabase/.temp
/supabase/.branches

# editor / OS
.DS_Store
*.log

# internal notes, not meant for the repo
CLAUDE.md

# real connector credentials for scripts/verify-connectors.ts (never commit)
connectors.json

# Local Claude Code settings, launch config and worktrees — machine-specific,
# not part of the project.
.claude/

# Scratch probes. A `probe-tmp.ts` has now been committed twice by accident
# (d429442 removed one, 43c1668 added another), so this is a rule rather than a
# reminder. Throwaway verification scripts belong outside the repo.
probe-*.ts
scratch-*.ts

# Scratch file written by the eval-loadability test.
evals/.import-probe.mts

# Self-hosted Supabase stack cloned by scripts/setup-selfhosted.sh
supabase-docker/

# Backups/copies of .env — same secrets, and the patterns above do not match
# names like .env.production.bak or .env.cloud.local.copy
.env.*.bak
.env.bak*
.env.backup*
.env.*.backup
.env.*.copy
.env.*.orig
.env.*.save

# Generated by the TanStack Router plugin on every build. Tracking it produced
# a diff on almost every branch and merge conflicts that mean nothing - the
# file is reproduced from the route files themselves.
src/routeTree.gen.ts

# Egress allow-list for notebook kernels. The app REWRITES these two whenever an
# administrator saves Admin -> Developer runtime, so tracking them meant every
# install carried a permanently dirty working tree — and staged whatever that
# operator had allow-listed, which for raw IPs is a piece of their internal
# network. The tracked templates are the .default files beside them; setup.sh
# and setup.ps1 seed the live pair from those on first run.
deploy/notebooks/egress/allowed_domains
deploy/notebooks/egress/allowed_ips
