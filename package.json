    "check:infra": "node scripts/check-infra.mjs",
    "docs:index": "node scripts/build-docs-index.mjs",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm run lint && npm run check:docs && npm run check:md-docs && npm run check:doc-commands && npm run check:infra && npm run test && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:differential": "tsx tests/differential/report.ts",
    "eval:nl2sql": "tsx evals/nl2sql/run.ts",
